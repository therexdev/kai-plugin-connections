{
  "schema": 2,
  "apiVersion": 3,
  "id": "kai.connections",
  "name": "KAI Connections",
  "version": "0.3.0",
  "description": "Connected app accounts, OAuth, API actions and event subscriptions, with credentials stored by this plugin.",
  "entry": "index.html",
  "permissions": [
    "native.execute",
    "models.read",
    "inference.local",
    "network.status",
    "network.fetch",
    "secrets.use",
    "services.call",
    "services.provide",
    "desktop.navigate",
    "desktop.external",
    "desktop.windows",
    "account.request"
  ],
  "runtime": "native",
  "service": "service/index.js",
  "provides": [
    "kai.connections"
  ],
  "consumes": [
    "kai.brain"
  ]
}
