{"manifest":{"schema":1,"apiVersion":2,"id":"kai.connections","name":"KAI Connections","version":"0.1.1","description":"Connect your apps and APIs with encrypted local credentials and reviewed actions.","entry":"index.html","permissions":["connections.read","connections.manage","connections.execute"]},"files":{"COMPOSIO-CATALOG-LICENSE.txt":"Catalog metadata in ui/connection-catalog.js is derived from:\nhttps://github.com/ComposioHQ/composio/blob/next/docs/public/data/toolkits.json\nRetrieved September 9, 2026; 1,516 toolkits. Regenerate with scripts/build-connection-catalog.js.\nProvider names and logos identify their respective services; no endorsement is implied.\n\nMIT License\n\nCopyright (c) 2025 Sampark Inc.\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n","app.js":"\"use strict\";\nfunction parseJson(text, kind = \"object\") { let value; try { value = JSON.parse(text); } catch { throw Error(\"Enter valid JSON before continuing.\"); } if (kind === \"array\" ? !Array.isArray(value) : !value || typeof value !== \"object\" || Array.isArray(value)) throw Error(`Expected a JSON ${kind}.`); return value; }\nfunction escapeHtml(value) { return String(value ?? \"\").replace(/[&<>\"']/g, c => ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\",\"'\":\"&#39;\"}[c])); }\nif (typeof module !== \"undefined\") module.exports = { parseJson, escapeHtml };\nif (typeof document !== \"undefined\") {\n const $=id=>document.getElementById(id),esc=escapeHtml; let state={connections:[],composio:{}},templates=[],editing=null,busy=false,apps=[],appCursor=null,access=null,accessRows=[],accessCursor=null,selected=new Map(),selectedApp=null;\n const catalogData=window.KaiConnectionCatalog||{items:[],categories:[]};\n const marks=new Set([\"gmail\",\"googlecalendar\",\"googledrive\",\"notion\",\"slack\",\"github\",\"linear\",\"outlook\",\"microsoft_teams\",\"googlesheets\",\"googledocs\",\"airtable\",\"dropbox\",\"trello\",\"asana\",\"hubspot\",\"salesforce\",\"shopify\",\"discord\",\"zoom\",\"youtube\",\"spotify\",\"figma\",\"clickup\"]);\n const popular=[...marks],rank=slug=>popular.includes(slug)?popular.indexOf(slug):popular.length;\n const catalog=[...catalogData.items].sort((a,b)=>rank(a.slug)-rank(b.slug)||a.name.localeCompare(b.name));\n const authLabel=a=>a.authSchemes?.some(s=>/OAUTH/.test(s))?\"Account sign-in\":a.authSchemes?.includes(\"NO_AUTH\")?\"No account required\":a.authSchemes?.length?\"API credentials\":\"Provider setup\";\n const logo=a=>`<span class=\"app-logo\">${marks.has(a.slug)?`<img src=\"assets/connections/${esc(a.slug)}.svg\" alt=\"\">`:`<span>${esc((a.name||a.slug||\"+\").slice(0,1).toUpperCase())}</span>`}</span>`;\n const banner=window.KaiPluginNotice.attach($(\"notice\"),{focusTarget:()=>document.querySelector('[data-tab][aria-selected=\"true\"]')});\n function notice(text,error=false){banner.show(text,{error,force:true});}\n async function call(method,input={}){if(!window.kai?.call)throw Error(\"Open this plugin inside KAI Core 0.2.0 or later.\");return window.kai.call(method,input);}\n async function action(fn,message=\"\"){if(busy)return;busy=true;for(const b of document.querySelectorAll(\"button:not(.kai-notice-close):not(.close-button)\"))b.disabled=true;notice(\"Waiting for Core…\");try{const result=await fn();notice(result?.cancelled?\"Cancelled. No action was taken.\":message);}catch(e){notice(e.message||\"The action failed.\",true);}finally{eraseSecrets();busy=false;for(const b of document.querySelectorAll(\"button:not(.kai-notice-close):not(.close-button)\"))b.disabled=false;}}\n function eraseSecrets(){$(\"secret\").value=\"\";$(\"provider-key\").value=\"\";}\n function tab(name){eraseSecrets();for(const id of [\"accounts\",\"discover\",\"api\",\"run\",\"settings\"])$(id).hidden=id!==name;for(const b of document.querySelectorAll(\"[data-tab]\"))b.setAttribute(\"aria-selected\",String(b.dataset.tab===name));}\n for(const b of document.querySelectorAll(\"[data-tab]\"))b.onclick=()=>tab(b.dataset.tab);\n document.addEventListener(\"visibilitychange\",()=>{if(document.hidden)eraseSecrets();});window.addEventListener(\"pagehide\",eraseSecrets);\n function render(){\n  $(\"privacy\").textContent=state.privacyMode||\"Privacy unavailable\";$(\"provider-mode\").value=state.composio.mode||\"managed\";\n  renderProviderMode();$(\"connection-method\").textContent=state.composio.mode===\"personal\"?\"Your Composio\":\"KAI-managed\";\n  const readiness=state.privacyMode===\"local-only\"?\"Online connections are paused in Local-Only. Choose an online mode in Core Settings to connect apps.\":state.composio.mode===\"personal\"&&!state.composio.personalConfigured?\"Add your Composio project key in Connection settings to connect apps.\":state.composio.mode!==\"personal\"&&!state.composio.signedIn?\"Sign in to KAI in Core Settings to connect apps with the managed service.\":\"\";\n  $(\"connection-readiness\").hidden=!readiness;$(\"connection-readiness-text\").textContent=readiness;\n  $(\"provider-status\").textContent=state.composio.mode===\"personal\"?(state.composio.personalConfigured?\"A personal key is saved securely.\":\"Add your project key to begin.\"):(state.composio.signedIn?\"KAI account signed in. Server availability is checked when you refresh.\":\"Sign in to KAI in Core Settings to use managed connections.\");\n  $(\"account-list\").innerHTML=state.connections.length?state.connections.map(c=>`<article class=\"card account-card\"><div class=\"spread\">${logo({slug:c.toolkit,name:c.name})}<span class=\"status ${c.status===\"ACTIVE\"?\"connected\":\"\"}\">${esc(c.status===\"ACTIVE\"?\"Connected\":c.status)}</span></div><h3>${esc(c.name)}</h3><p class=\"muted\">${esc(c.provider===\"composio\"?c.toolkit:c.baseUrl)}</p><p class=\"mini muted\">${c.operations.length} actions · ${c.enabled?\"Enabled\":\"Disabled\"} · Agents ${c.allowAgent?\"on\":\"off\"}</p><div class=\"actions\"><button data-id=\"${esc(c.id)}\" data-action=\"run\">Run action</button><button data-id=\"${esc(c.id)}\" data-action=\"${c.provider===\"composio\"?\"access\":\"edit\"}\">${c.provider===\"composio\"?\"Manage access\":\"Edit\"}</button><button class=\"danger\" data-id=\"${esc(c.id)}\" data-action=\"remove\">${c.provider===\"composio\"?\"Disconnect\":\"Remove\"}</button></div></article>`).join(\"\"):'<div class=\"empty\">No connections yet. Sign in to an app or add an API token to get started.</div>';\n  for(const b of $(\"account-list\").querySelectorAll(\"button\"))b.onclick=()=>{const c=state.connections.find(c=>c.id===b.dataset.id);if(!c)return;if(b.dataset.action===\"run\"){tab(\"run\");$(\"run-account\").value=c.id;renderOperations();}else if(b.dataset.action===\"edit\")edit(c);else if(b.dataset.action===\"access\")void action(()=>openAccess(c));else void action(async()=>{const result=await call(c.provider===\"composio\"?\"connections.composio.disconnect\":\"connections.remove\",{id:c.id});await refresh();return result;},\"Connection removed.\");};\n  const prior=$(\"run-account\").value;$(\"run-account\").innerHTML='<option value=\"\">Select a connection</option>'+state.connections.map(c=>`<option value=\"${esc(c.id)}\">${esc(c.name)}</option>`).join(\"\");if(state.connections.some(c=>c.id===prior))$(\"run-account\").value=prior;renderOperations();\n }\n async function refresh(){state=await call(\"connections.status\");render();}\n function renderOperations(){const c=state.connections.find(c=>c.id===$(\"run-account\").value);$(\"run-operation\").innerHTML='<option value=\"\">Select an action</option>'+(c?.operations||[]).map(o=>`<option value=\"${esc(o.id)}\">${esc(o.name||o.id)}</option>`).join(\"\");renderOperation();}\n function renderOperation(){const c=state.connections.find(c=>c.id===$(\"run-account\").value),o=c?.operations.find(o=>o.id===$(\"run-operation\").value);$(\"operation-detail\").textContent=o?(o.schema?JSON.stringify(o.schema,null,2):`${o.method} ${o.path}`):\"Select a saved action.\";}\n function auth(){$(\"header-label\").hidden=$(\"auth\").value!==\"header\";$(\"secret-label\").hidden=$(\"auth\").value===\"none\";}\n function fill(t){$(\"api-name\").value=t.name;$(\"base-url\").value=t.baseUrl;$(\"auth\").value=t.auth;$(\"header-name\").value=t.headerName||\"X-API-Key\";$(\"operations\").value=JSON.stringify(t.operations.map(({id,name,method,path})=>({id,name,method,path})),null,2);$(\"headers\").value=JSON.stringify(t.headers||{},null,2);$(\"secret\").value=\"\";auth();}\n function resetApi(){editing=null;$(\"api-title\").textContent=\"Add an API connection\";$(\"api-form\").reset();fill(templates.find(t=>t.id===$(\"template\").value)||templates[0]);}\n function edit(c){tab(\"api\");editing=c.id;$(\"api-title\").textContent=\"Edit API connection\";fill(c);$(\"api-enabled\").checked=c.enabled;$(\"api-agent\").checked=c.allowAgent;$(\"api-sync\").checked=c.allowSync;}\n $(\"template\").onchange=()=>{editing=null;$(\"api-title\").textContent=\"Add an API connection\";fill(templates.find(t=>t.id===$(\"template\").value));};$(\"auth\").onchange=auth;$(\"api-reset\").onclick=resetApi;$(\"run-account\").onchange=renderOperations;$(\"run-operation\").onchange=renderOperation;\n $(\"refresh\").onclick=()=>action(async()=>{state=await call(\"connections.composio.refresh\");render();},\"Accounts refreshed.\");\n $(\"api-form\").onsubmit=e=>{e.preventDefault();void action(async()=>{const input={...(editing?{id:editing}:{}),name:$(\"api-name\").value,baseUrl:$(\"base-url\").value,auth:$(\"auth\").value,headerName:$(\"header-name\").value,secret:$(\"secret\").value,headers:parseJson($(\"headers\").value),operations:parseJson($(\"operations\").value,\"array\"),enabled:$(\"api-enabled\").checked,allowAgent:$(\"api-agent\").checked,allowSync:$(\"api-sync\").checked};eraseSecrets();const result=await call(\"connections.save\",input);input.secret=\"\";if(!result.cancelled){await refresh();resetApi();tab(\"accounts\");}return result;},\"API connection saved.\");};\n $(\"provider-form\").onsubmit=e=>{e.preventDefault();void action(async()=>{const input={mode:$(\"provider-mode\").value,key:$(\"provider-key\").value,clearKey:$(\"clear-key\").checked};eraseSecrets();const result=await call(\"connections.composio.settings\",input);input.key=\"\";$(\"clear-key\").checked=false;await refresh();return result;},\"Provider settings saved.\");};\n function searchApps(more=false){\n  const terms=$(\"search\").value.toLowerCase().trim().split(/\\s+/).filter(Boolean),category=$(\"category\").value,auth=$(\"catalog-auth\").value;\n  const matching=catalog.filter(a=>(!category||a.category===category)&&(!auth||authLabel(a)===auth)&&terms.every(t=>`${a.name} ${a.slug} ${a.description} ${a.originalCategory}`.toLowerCase().includes(t)));\n  const count=more?apps.length+72:72;apps=matching.slice(0,count);appCursor=matching.length>apps.length;\n  $(\"catalog-count\").textContent=`${apps.length} of ${matching.length.toLocaleString()} apps`;\n  $(\"more-apps\").hidden=!appCursor;$(\"apps\").innerHTML=apps.length?apps.map((a,i)=>`<button class=\"app-card\" type=\"button\" data-app=\"${i}\">${logo(a)}<strong>${esc(a.name||a.slug)}</strong><span class=\"app-auth\">${esc(authLabel(a))}</span><span class=\"app-connect\">${state.connections.some(c=>c.toolkit===a.slug&&c.status===\"ACTIVE\")?\"Connected ✓\":\"Connect ↗\"}</span></button>`).join(\"\"):'<div class=\"empty\"><h3>No apps match that search</h3><p>Try an app name or another category.</p></div>';\n  for(const b of $(\"apps\").querySelectorAll(\"button\"))b.onclick=()=>{selectedApp=apps[Number(b.dataset.app)];$(\"app-dialog-title\").textContent=selectedApp.name||selectedApp.slug;$(\"app-dialog-description\").textContent=selectedApp.description;$(\"app-dialog-icon\").innerHTML=logo(selectedApp);$(\"app-dialog-connect\").textContent=`Connect ${selectedApp.name||selectedApp.slug}`;$(\"app-dialog\").showModal();};\n }\n $(\"search-form\").onsubmit=e=>{e.preventDefault();searchApps();};$(\"search\").oninput=()=>searchApps();$(\"category\").onchange=()=>searchApps();$(\"catalog-auth\").onchange=()=>searchApps();$(\"more-apps\").onclick=()=>searchApps(true);\n $(\"app-dialog-close\").onclick=()=>$(\"app-dialog\").close();\n $(\"app-dialog-connect\").onclick=()=>{const app=selectedApp;if(!app)return;$(\"app-dialog\").close();void action(()=>call(\"connections.composio.connect\",{toolkit:app.slug}),\"Complete sign-in in your browser, then refresh your connected apps.\");};\n function renderProviderMode(){const personal=$(\"provider-mode\").value===\"personal\";$(\"mode-personal\").checked=personal;$(\"mode-managed\").checked=!personal;$(\"personal-key-field\").hidden=!personal;}\n for(const mode of [\"managed\",\"personal\"])$(\"mode-\"+mode).onchange=()=>{$(\"provider-mode\").value=mode;eraseSecrets();renderProviderMode();};\n $(\"provider-mode\").onchange=renderProviderMode;\n async function openAccess(c){access=c;selected=new Map(c.operations.map(o=>[o.id,{id:o.id,version:o.version}]));$(\"access-name\").value=c.name;$(\"allow-write\").checked=c.allowWrite;$(\"allow-agent\").checked=c.allowAgent;$(\"allow-sync\").checked=c.allowSync;$(\"access-search\").value=\"\";$(\"access-title\").textContent=`Permissions · ${c.name}`;$(\"access-form\").hidden=false;await loadAccess();$(\"access-form\").scrollIntoView({behavior:\"smooth\"});}\n async function loadAccess(more=false){if(!access)return;const page=await call(\"connections.composio.tools\",{toolkit:access.toolkit,search:$(\"access-search\").value,...(more&&accessCursor?{cursor:accessCursor}:{})});accessRows=more?[...accessRows,...page.items]:page.items;accessCursor=page.nextCursor||null;$(\"access-more\").hidden=!accessCursor;renderAccess();}\n function renderAccess(){const shown=new Map([...access.operations,...accessRows].map(t=>[t.id,t]));$(\"access-tools\").innerHTML=[...shown.values()].map(t=>`<label class=\"check\"><input type=\"checkbox\" data-tool=\"${esc(t.id)}\" ${selected.has(t.id)?\"checked\":\"\"}><span>${esc(t.name||t.id)}<br><small>${esc(t.description||t.id)} · ${t.readOnly?\"Read\":\"May change data\"}</small></span></label>`).join(\"\")||'<p class=\"muted\">No actions found.</p>';for(const input of $(\"access-tools\").querySelectorAll(\"input\"))input.onchange=()=>{const t=shown.get(input.dataset.tool);input.checked?selected.set(t.id,{id:t.id,version:t.version}):selected.delete(t.id);};}\n $(\"access-find\").onclick=()=>action(()=>loadAccess());$(\"access-more\").onclick=()=>action(()=>loadAccess(true));$(\"access-close\").onclick=()=>{$(\"access-form\").hidden=true;access=null;};\n $(\"access-form\").onsubmit=e=>{e.preventDefault();void action(async()=>{if(!access)throw Error(\"Choose an account first.\");const result=await call(\"connections.composio.permissions\",{id:access.id,name:$(\"access-name\").value,tools:[...selected.values()],allowWrite:$(\"allow-write\").checked,allowAgent:$(\"allow-agent\").checked,allowSync:$(\"allow-sync\").checked});if(!result.cancelled){state=result;render();$(\"access-form\").hidden=true;access=null;}return result;},\"Account permissions saved.\");};\n $(\"run-form\").onsubmit=e=>{e.preventDefault();void action(async()=>{if(!$(\"run-account\").value||!$(\"run-operation\").value)throw Error(\"Select a connection and an action.\");const result=await call(\"connections.execute\",{id:$(\"run-account\").value,operationId:$(\"run-operation\").value,variables:parseJson($(\"variables\").value),body:parseJson($(\"body\").value)});if(!result.cancelled)$(\"result\").textContent=typeof result.result===\"string\"?result.result:JSON.stringify(result.result,null,2);await refresh();return result;},\"Action completed.\");};\n void action(async()=>{templates=await call(\"connections.templates\");$(\"template\").innerHTML=templates.map(t=>`<option value=\"${esc(t.id)}\">${esc(t.name)}</option>`).join(\"\");resetApi();await refresh();$(\"category\").innerHTML='<option value=\"\">All apps</option>'+catalogData.categories.map(c=>`<option value=\"${esc(c.id)}\">${esc(c.name)}</option>`).join(\"\");searchApps();});\n}\n","assets/connections/NOTICE.txt":"# Platform marks\n\nBundled SVG platform logos were obtained from `https://logos.composio.dev/api/<toolkit-slug>` on September 9, 2026. Each filename identifies its toolkit slug. Logos identify third-party services in the connection catalog; all marks belong to their respective owners and do not imply endorsement or affiliation. Additional catalog logos are fetched by Electron from the same fixed HTTPS service and rendered as images, with a text fallback.\n","assets/connections/airtable.svg":"<svg width=\"128\" height=\"128\" viewBox=\"0 0 128 128\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<g clip-path=\"url(#clip0_0_309)\">\n<path d=\"M57.1183 11.8136L9.51971 31.5412C6.88172 32.6882 6.88172 36.3584 9.51971 37.5054L57.3477 56.5448C61.5914 58.1505 66.1792 58.1505 70.4229 56.5448L118.366 37.5054C121.004 36.3584 121.118 32.6882 118.366 31.5412L70.767 11.8136C66.4086 9.97849 61.4767 9.97849 57.1183 11.8136Z\" fill