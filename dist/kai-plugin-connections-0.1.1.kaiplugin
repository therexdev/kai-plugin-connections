managedSchemes\":[],\"toolCount\":12,\"triggerCount\":0},{\"slug\":\"ynab\",\"name\":\"YNAB\",\"description\":\"YNAB (You Need A Budget) is a budgeting tool helping users track expenses, plan finances, and gain control over spending to reduce debt\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"accounting\",\"authSchemes\":[\"OAUTH2\"],\"managedSchemes\":[\"OAUTH2\"],\"toolCount\":27,\"triggerCount\":0},{\"slug\":\"yousearch\",\"name\":\"You.com\",\"description\":\"YouSearch is a search engine or search tool that enables users to find relevant information, possibly with enhanced filtering or privacy-focused features\",\"category\":\"automation\",\"categories\":[\"AI & automation\"],\"originalCategory\":\"artificial intelligence\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":1,\"triggerCount\":0},{\"slug\":\"youtube\",\"name\":\"YouTube\",\"description\":\"YouTube is a video-sharing platform with user-generated content, live streaming, and monetization opportunities, widely used for marketing, education, and entertainment\",\"category\":\"lifestyle\",\"categories\":[\"Everyday life\"],\"originalCategory\":\"video & audio\",\"authSchemes\":[\"OAUTH2\"],\"managedSchemes\":[\"OAUTH2\"],\"toolCount\":51,\"triggerCount\":4},{\"slug\":\"youtube_transcript\",\"name\":\"YouTube Transcript\",\"description\":\"Retrieve and store captions for one video or a bounded batch, read job and batch status, access stored transcripts and languages, and resolve playlist or channel video metadata through the YouTube Transcript REST API.\",\"category\":\"automation\",\"categories\":[\"AI & automation\"],\"originalCategory\":\"transcription\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":9,\"triggerCount\":0},{\"slug\":\"zendesk\",\"name\":\"Zendesk\",\"description\":\"Zendesk provides customer support software with ticketing, live chat, and knowledge base features, enabling efficient helpdesk operations and customer engagement\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"crm\",\"authSchemes\":[\"OAUTH2\"],\"managedSchemes\":[\"OAUTH2\"],\"toolCount\":452,\"triggerCount\":2},{\"slug\":\"zenrows\",\"name\":\"ZenRows\",\"description\":\"ZenRows is a web scraping API allowing developers to bypass CAPTCHAs and blocks, gather structured data from dynamic websites, and quickly integrate results into applications\",\"category\":\"automation\",\"categories\":[\"AI & automation\"],\"originalCategory\":\"ai web scraping\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":14,\"triggerCount\":0},{\"slug\":\"zenserp\",\"name\":\"Zenserp\",\"description\":\"Zenserp is a real-time SERP API that extracts Google Search results in JSON format.\",\"category\":\"automation\",\"categories\":[\"AI & automation\"],\"originalCategory\":\"ai web scraping\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":12,\"triggerCount\":0},{\"slug\":\"zep\",\"name\":\"Zep\",\"description\":\"The Foundational Memory Layer for AI. Equip your agents with the knowledge to complete tasks, from the mundane to monumental.\",\"category\":\"automation\",\"categories\":[\"AI & automation\"],\"originalCategory\":\"artificial intelligence\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":41,\"triggerCount\":0},{\"slug\":\"zeplin\",\"name\":\"Zeplin\",\"description\":\"Zeplin is a design delivery platform that connects designers and developers, enabling access to design resources like projects, screens, components, and assets.\",\"category\":\"productivity\",\"categories\":[\"Productivity & design\"],\"originalCategory\":\"images & design\",\"authSchemes\":[\"OAUTH2\",\"API_KEY\"],\"managedSchemes\":[\"OAUTH2\"],\"toolCount\":24,\"triggerCount\":0},{\"slug\":\"zernio_mcp\",\"name\":\"Zernio MCP\",\"description\":\"Zernio is a social media management API for scheduling posts, pulling analytics, managing inbox conversations and running ads across 14+ platforms including Facebook, Instagram, LinkedIn, TikTok, X, YouTube, Reddit, Pinterest, WhatsApp Business and Telegram.\",\"category\":\"social\",\"categories\":[\"Marketing & social\"],\"originalCategory\":\"social media marketing\",\"authSchemes\":[\"DCR_OAUTH\"],\"managedSchemes\":[],\"toolCount\":51,\"triggerCount\":0},{\"slug\":\"zerobounce\",\"name\":\"Zerobounce\",\"description\":\"ZeroBounce is an email validation and deliverability platform that helps businesses improve email marketing performance by identifying and removing invalid or risky email addresses.\",\"category\":\"communication\",\"categories\":[\"Chat & email\"],\"originalCategory\":\"email\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":20,\"triggerCount\":0},{\"slug\":\"zigpoll\",\"name\":\"Zigpoll\",\"description\":\"Zigpoll is a survey and feedback platform for creating polls, collecting responses, analyzing insights, and running customer research.\",\"category\":\"productivity\",\"categories\":[\"Productivity & design\"],\"originalCategory\":\"forms & surveys\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":2,\"triggerCount\":0},{\"slug\":\"ziprecruiter_mcp\",\"name\":\"ZipRecruiter MCP\",\"description\":\"Search job listings across ZipRecruiter's marketplace by role, location, and salary.\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"hr talent & recruitment\",\"authSchemes\":[\"NO_AUTH\"],\"managedSchemes\":[],\"toolCount\":1,\"triggerCount\":0},{\"slug\":\"zixflow\",\"name\":\"Zixflow\",\"description\":\"AI-CRM and Messaging Across SMS, Email, and WhatsApp\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"crm\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":7,\"triggerCount\":0},{\"slug\":\"zoho\",\"name\":\"Zoho\",\"description\":\"Zoho is a suite of cloud applications including CRM, email marketing, and collaboration tools, enabling businesses to automate and scale operations\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"crm\",\"authSchemes\":[\"OAUTH2\"],\"managedSchemes\":[\"OAUTH2\"],\"toolCount\":57,\"triggerCount\":0},{\"slug\":\"zoho_bigin\",\"name\":\"Zoho Bigin\",\"description\":\"Zoho Bigin is a simplified CRM solution from Zoho tailored for small businesses, focusing on pipeline tracking and relationship management\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"crm\",\"authSchemes\":[\"OAUTH2\"],\"managedSchemes\":[\"OAUTH2\"],\"toolCount\":54,\"triggerCount\":0},{\"slug\":\"zoho_books\",\"name\":\"Zoho Books\",\"description\":\"Zoho Books handles accounting, invoicing, and expense tracking, offering real-time collaboration and integrations within the Zoho ecosystem\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"accounting\",\"authSchemes\":[\"OAUTH2\"],\"managedSchemes\":[\"OAUTH2\"],\"toolCount\":265,\"triggerCount\":0},{\"slug\":\"zoho_desk\",\"name\":\"Zoho Desk\",\"description\":\"Zoho Desk is a context-aware helpdesk platform enabling support teams to track tickets, automate workflows, and gain insights on customer interactions\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"crm\",\"authSchemes\":[\"OAUTH2\"],\"managedSchemes\":[\"OAUTH2\"],\"toolCount\":31,\"triggerCount\":0},{\"slug\":\"zoho_inventory\",\"name\":\"Zoho Inventory\",\"description\":\"Zoho Inventory helps businesses track stock, manage orders, and sync inventory across multiple sales channels, streamlining supply chain operations\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"accounting\",\"authSchemes\":[\"OAUTH2\"],\"managedSchemes\":[\"OAUTH2\"],\"toolCount\":58,\"triggerCount\":0},{\"slug\":\"zoho_invoice\",\"name\":\"Zoho Invoice\",\"description\":\"Zoho Invoice simplifies billing, recurring payments, and expense management, helping freelancers and small businesses send professional invoices\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"proposal & invoice management\",\"authSchemes\":[\"OAUTH2\"],\"managedSchemes\":[\"OAUTH2\"],\"toolCount\":137,\"triggerCount\":0},{\"slug\":\"zoho_mail\",\"name\":\"Zoho Mail\",\"description\":\"Zoho Mail is a secure and ad-free email hosting platform with collaboration tools, calendar integration, and extensive administrative controls\",\"category\":\"communication\",\"categories\":[\"Chat & email\"],\"originalCategory\":\"email\",\"authSchemes\":[\"OAUTH2\"],\"managedSchemes\":[\"OAUTH2\"],\"toolCount\":15,\"triggerCount\":0},{\"slug\":\"zoom\",\"name\":\"Zoom\",\"description\":\"Zoom is a video conferencing and online meeting platform featuring breakout rooms, screen sharing, and integrations with various enterprise tools\",\"category\":\"communication\",\"categories\":[\"Chat & email\"],\"originalCategory\":\"video conferencing\",\"authSchemes\":[\"OAUTH2\"],\"managedSchemes\":[\"OAUTH2\"],\"toolCount\":105,\"triggerCount\":11},{\"slug\":\"zoom_chat\",\"name\":\"Zoom Team Chat\",\"description\":\"Zoom Team Chat is Zoom's persistent messaging product: channels, direct messages, threads, reactions, file sharing, reminders and shared spaces, all accessible through the Zoom REST API as the connected user\",\"category\":\"communication\",\"categories\":[\"Chat & email\"],\"originalCategory\":\"team chat\",\"authSchemes\":[\"OAUTH2\"],\"managedSchemes\":[],\"toolCount\":44,\"triggerCount\":0},{\"slug\":\"zoominfo\",\"name\":\"Zoominfo\",\"description\":\"ZoomInfo is a go-to-market intelligence platform that provides AI-powered B2B data and sales intelligence to help GTM teams find in-market buyers, build pipeline, and close deals faster.\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"crm\",\"authSchemes\":[\"OAUTH2\"],\"managedSchemes\":[],\"toolCount\":16,\"triggerCount\":0},{\"slug\":\"zulip\",\"name\":\"Zulip\",\"description\":\"Chat for distributed teams. Zulip combines the immediacy of real-time chat with an email threading model.\",\"category\":\"communication\",\"categories\":[\"Chat & email\"],\"originalCategory\":\"team chat\",\"authSchemes\":[\"BASIC\"],\"managedSchemes\":[],\"toolCount\":111,\"triggerCount\":0},{\"slug\":\"zylvie\",\"name\":\"Zylvie\",\"description\":\"High-converting cart software for solopreneurs to sell digital products and subscriptions.\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"ecommerce\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":4,\"triggerCount\":0},{\"slug\":\"zyte_api\",\"name\":\"Zyte Api\",\"description\":\"Zyte API is a web scraping solution that automates data extraction from websites, handling challenges like bans and dynamic content.\",\"category\":\"automation\",\"categories\":[\"AI & automation\"],\"originalCategory\":\"ai web scraping\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":7,\"triggerCount\":0}]};\n","index.html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'\"><title>KAI Connections</title><link rel=\"stylesheet\" href=\"kai-theme.css\"><link rel=\"stylesheet\" href=\"style.css\"></head><body><main>\n<header class=\"workspace-header\"><div class=\"workspace-name\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m10 13 4-4M8 15l-1 1a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0M16 9l1-1a4 4 0 1 1 6 6l-4 4a4 4 0 0 1-6 0\"/></svg><h1>Connections</h1></div><span class=\"pill\" id=\"privacy\">Connecting to Core</span></header>\n<div class=\"workspace-page\"><div id=\"notice\" role=\"status\" aria-live=\"polite\" hidden></div><div class=\"hub-shell\"><nav class=\"hub-rail\" aria-label=\"Connection sections\"><div class=\"hub-rail-label\">Connections</div><button data-tab=\"discover\" aria-selected=\"true\">Explore apps</button><button data-tab=\"accounts\" aria-selected=\"false\">Connected</button><button data-tab=\"settings\" aria-selected=\"false\">Connection settings</button><button data-tab=\"api\" aria-selected=\"false\">Custom APIs</button><button data-tab=\"run\" aria-selected=\"false\">Run an action</button></nav><div class=\"hub-content\">\n\n<section id=\"accounts\" hidden><div class=\"section-heading spread\"><div><h2>Your connected apps</h2><p class=\"muted\">Choose what KAI can use, and which actions are available.</p></div><div class=\"actions\"><button data-tab=\"discover\" class=\"primary\">Connect an app</button><button id=\"refresh\">Refresh</button></div></div><div id=\"account-list\" class=\"cards\"></div><form id=\"access-form\" class=\"panel stack\" hidden><h2 id=\"access-title\">Account access</h2><label>Account label<input id=\"access-name\" maxlength=\"80\"></label><p class=\"muted\">Choose the actions this account makes available. Write actions also require the permission below.</p><div class=\"actions\"><input id=\"access-search\" placeholder=\"Search available actions\" aria-label=\"Search available actions\"><button id=\"access-find\" type=\"button\">Search</button></div><div id=\"access-tools\" class=\"tool-list\"></div><button id=\"access-more\" type=\"button\" hidden>More actions</button><label class=\"check\"><input id=\"allow-write\" type=\"checkbox\">Allow selected actions to change data</label><label class=\"check\"><input id=\"allow-agent\" type=\"checkbox\">Allow my personal agents to use selected actions</label><label class=\"check\"><input id=\"allow-sync\" type=\"checkbox\">Allow background sources to read selected data</label><div class=\"actions\"><button class=\"primary\" type=\"submit\">Review permissions</button><button id=\"access-close\" type=\"button\">Close</button></div></form></section>\n<section id=\"discover\"><div class=\"cn-hero\"><div><h2>Bring your everyday apps to KAI.</h2><p>Connect the apps you use and choose what KAI can do with them.</p></div><div class=\"cn-route\"><span class=\"route-dot\"></span><span id=\"connection-method\">KAI-managed</span><button data-tab=\"settings\" class=\"text-button\">Change</button></div></div>\n<div id=\"connection-readiness\" class=\"readiness\" hidden><p id=\"connection-readiness-text\"></p><button data-tab=\"settings\">Connection settings</button></div>\n<form id=\"search-form\" class=\"cn-searchbar\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></svg><input id=\"search\" type=\"search\" placeholder=\"Search apps, tools, or what you want to do…\" aria-label=\"Search apps\"><button type=\"submit\">Search</button></form>\n<div class=\"cn-categories\"><label>Category<select id=\"category\"><option value=\"\">All apps</option></select></label><label>Connection type<select id=\"catalog-auth\"><option value=\"\">All types</option><option>Account sign-in</option><option>API credentials</option><option>No account required</option><option>Provider setup</option></select></label></div>\n<div class=\"section-heading spread\"><h2>Explore apps</h2><span id=\"catalog-count\" class=\"muted\"></span></div><div id=\"apps\" class=\"app-grid\"></div><button id=\"more-apps\" hidden>Show more apps</button><p class=\"note\">Sign in securely, then choose the actions and data KAI can use. After browser sign-in, refresh your connected apps.</p>\n</section>\n<section id=\"api\" hidden><div class=\"grid\"><form id=\"api-form\" class=\"panel stack\"><h2 id=\"api-title\">Add an API connection</h2><label>Template<select id=\"template\"></select></label><label>Name<input id=\"api-name\" required maxlength=\"80\"></label><label>API base URL<input id=\"base-url\" type=\"url\" required></label><label>Authentication<select id=\"auth\"><option value=\"bearer\">Bearer token</option><option value=\"header\">API key header</option><option value=\"none\">None</option></select></label><label id=\"header-label\" hidden>Secret header name<input id=\"header-name\" value=\"X-API-Key\"></label><label id=\"secret-label\">API token<input id=\"secret\" type=\"password\" autocomplete=\"new-password\" maxlength=\"4096\" placeholder=\"Enter a token; saved tokens are never displayed\"></label><label class=\"check\"><input id=\"api-enabled\" type=\"checkbox\" checked>Enabled</label><label class=\"check\"><input id=\"api-agent\" type=\"checkbox\">Allow personal agent access</label><label class=\"check\"><input id=\"api-sync\" type=\"checkbox\">Allow background source reads</label><div class=\"actions\"><button class=\"primary\" type=\"submit\">Review and save</button><button id=\"api-reset\" type=\"button\">New connection</button></div></form><div class=\"panel stack\"><h2>Available actions</h2><p class=\"muted\">Each action has a unique lowercase ID, name, HTTP method, and relative path. Use {name} for path variables.</p><label>Operations (JSON array)<textarea id=\"operations\" rows=\"13\" spellcheck=\"false\"></textarea></label><label>Public API-version headers (JSON object)<textarea id=\"headers\" spellcheck=\"false\">{}</textarea></label><p class=\"note\">Tokens pass to Core once for encrypted storage and are cleared from this form. Each manual action has a separate native review.</p></div></div></section>\n<section id=\"run\" hidden><div class=\"grid\"><form id=\"run-form\" class=\"panel stack\"><h2>Run a saved action</h2><label>Connection<select id=\"run-account\"></select></label><label>Action<select id=\"run-operation\"></select></label><pre id=\"operation-detail\">Select a connection.</pre><label>Path variables / app arguments (JSON object)<textarea id=\"variables\" spellcheck=\"false\">{}</textarea></label><label>API request body (JSON, for write operations)<textarea id=\"body\" spellcheck=\"false\">{}</textarea></label><button type=\"submit\" class=\"primary\">Review and run</button></form><div class=\"panel\"><h2>Result</h2><p class=\"muted\">Saved credentials remain in Core. This view displays the selected action's response.</p><pre id=\"result\">No action has run yet.</pre></div></div></section>\n<section id=\"settings\" hidden><div class=\"grid\"><form id=\"provider-form\" class=\"panel stack\"><h2>How would you like to connect?</h2><p class=\"muted\">Both options use the same app catalog and secure sign-in flow.</p><p id=\"provider-status\" class=\"muted\"></p><label class=\"sr-only\">Connection method<select id=\"provider-mode\"><option value=\"managed\">KAI-managed connections</option><option value=\"personal\">My Composio project</option></select></label><div class=\"provider-options\"><label class=\"provider-option\"><input id=\"mode-managed\" type=\"radio\" name=\"connection-mode\" value=\"managed\" checked><span class=\"provider-icon\">K</span><strong>KAI-managed</strong><span>Use the connection service configured by your KAI server. No Composio key to enter.</span></label><label class=\"provider-option\"><input id=\"mode-personal\" type=\"radio\" name=\"connection-mode\" value=\"personal\"><span class=\"provider-icon personal\">C</span><strong>My Composio key</strong><span>Connect through your own Composio project. Manage usage and billing directly.</span></label></div><label id=\"personal-key-field\" hidden>Composio project API key<input id=\"provider-key\" type=\"password\" autocomplete=\"new-password\" maxlength=\"4096\" placeholder=\"Leave blank to keep the saved key\"></label><label class=\"check\"><input id=\"clear-key\" type=\"checkbox\">Remove the saved personal key</label><button class=\"primary\" type=\"submit\">Review provider settings</button></form><div class=\"panel\"><h2>Credentials stay with you</h2><p class=\"muted\">Core encrypts credentials using your operating system's secure storage. This plugin receives account metadata and selected action responses.</p><p class=\"note\">KAI-managed connections require account sign-in and a server configured for Composio. Your own project works with a Composio API key. Local-Only blocks account API requests.</p><p class=\"muted\">Connecting an account does not grant it to rented agents or publish it to the Agent Network.</p></div></div></section></div></div></div></main><dialog id=\"app-dialog\" aria-labelledby=\"app-dialog-title\"><div class=\"spread\"><h2 id=\"app-dialog-title\">Connect an app</h2><button id=\"app-dialog-close\" class=\"close-button\" type=\"button\" aria-label=\"Close app details\" title=\"Close\">×</button></div><div id=\"app-dialog-icon\"></div><p id=\"app-dialog-description\" class=\"muted\"></p><ol class=\"connect-steps\"><li>Sign in and approve the account in your browser.</li><li>Choose the account and permissions to share.</li><li>Return to Connected, refresh, and choose what KAI can use.</li></ol><p class=\"note\">Available sign-in methods depend on the app and your connection provider.</p><button id=\"app-dialog-connect\" class=\"primary\">Connect app</button></dialog><script src=\"connection-catalog.js\"></script><script src=\"kai-notices.js\"></script><script src=\"app.js\"></script></body></html>","kai-notices.js":"\"use strict\";\n(function (root) {\n  const attached = new WeakMap();\n  function attach(container, { focusTarget } = {}) {\n    if (attached.has(container)) return attached.get(container);\n    const document = container.ownerDocument, initial = container.textContent;\n    const message = document.createElement(\"span\"), close = document.createElement(\"button\"), symbol = document.createElement(\"span\");\n    message.className = \"kai-notice-text\"; message.setAttribute(\"role\", \"status\"); message.setAttribute(\"aria-atomic\", \"true\");\n    close.className = \"kai-notice-close\"; close.type = \"button\"; close.title = \"Dismiss message\"; close.setAttribute(\"aria-label\", \"Dismiss message\");\n    symbol.textContent = \"×\"; symbol.setAttribute(\"aria-hidden\", \"true\"); close.append(symbol);\n    container.classList.add(\"kai-notice\"); container.removeAttribute(\"role\"); container.removeAttribute(\"aria-live\"); container.replaceChildren(message, close);\n    let current = \"\", dismissed = null;\n    function show(value, { error = false, dismissible = true, force = false } = {}) {\n      const content = String(value ?? \"\"), key = JSON.stringify([content, error, dismissible]);\n      if (force || key !== current) dismissed = null;\n      current = key;\n      if (message.textContent !== content) message.textContent = content;\n      container.classList.toggle(\"error\", error); close.hidden = !dismissible;\n      container.hidden = !content || current === dismissed;\n    }\n    function dismiss() {\n      if (container.hidden || close.hidden) return;\n      const hadFocus = document.activeElement === close;\n      dismissed = current; container.hidden = true;\n      if (hadFocus) {\n        const target = focusTarget?.();\n        if (target && !target.disabled && target.getClientRects().length) target.focus({ preventScroll: true });\n      }\n    }\n    close.onclick = dismiss;\n    const api = { show, dismiss, clear() { show(\"\"); } };\n    attached.set(container, api); show(initial);\n    return api;\n  }\n  root.KaiPluginNotice = { attach };\n})(window);\n","kai-theme.css":"/* KAI workspace primitives, shared by the first-party plugin windows. */\n:root{color-scheme:light;--bg:#f4f7fd;--bg-raised:#fff;--bg-input:#f5f8fe;--panel:#fff;--surface:#fff;--border:#dce5f2;--line:#dce5f2;--text:#14284e;--text-dim:#61728d;--muted:#61728d;--accent:#155eef;--violet:#155eef;--sky:#096bdc;--emerald:#168469;--mint:#168469;--danger:#c93d4c;--radius:14px;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}\n*{box-sizing:border-box;scrollbar-width:thin;scrollbar-color:#bdcde2 #f4f7fd}\n*::-webkit-scrollbar{width:9px;height:9px}*::-webkit-scrollbar-track,*::-webkit-scrollbar-corner{background:#f4f7fd}*::-webkit-scrollbar-thumb{background:#bdcde2;border:2px solid #f4f7fd;border-radius:8px}*::-webkit-scrollbar-thumb:hover{background:#9eb4d1}\nbody{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{border:1px solid var(--border);border-radius:9px;background:#fff;color:var(--text);padding:9px 14px;font-size:12px;font-weight:550;cursor:pointer;transition:background .15s,border-color .15s}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:650}button.primary:hover:not(:disabled){background:#0c4ed3;border-color:#0c4ed3}\ninput,select,textarea{background:var(--bg-input);border:1px solid var(--border);border-radius:9px;padding:10px 12px;color:var(--text);max-width:100%;font-size:12px}input::placeholder,textarea::placeholder{color:#8795aa}textarea{resize:vertical}label{font-size:12px;color:var(--text-dim)}a{color:var(--accent)}p{font-size:12px;line-height:1.7}h1,h2,h3{line-height:1.4;font-weight:600}h1{font-size:24px;letter-spacing:-.5px}h2{font-size:16px;letter-spacing:-.2px}h3{font-size:13px}.muted,.hint,.small{color:var(--text-dim);font-size:11px;line-height:1.6}\n:where(.workspace-header,.kai-workspace-header){display:flex;align-items:center;gap:12px;min-height:74px;height:74px;flex:none;border-bottom:1px solid var(--border);padding:0 28px;background:var(--bg)}:where(.workspace-header,.kai-workspace-header) h1{font-size:15px;letter-spacing:0;margin:0;font-weight:650}:where(.workspace-header,.kai-workspace-header) svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n.kai-notice{display:flex;align-items:flex-start;gap:12px;min-width:0;padding:10px 13px;border:1px solid #c6d9f9;border-radius:10px;background:#eaf2ff;color:#184b9c;font-size:12px;line-height:1.6;overflow-wrap:anywhere}.kai-notice.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.kai-notice-text{flex:1;min-width:0;align-self:center;max-height:30vh;overflow:auto;white-space:pre-wrap}.kai-notice .kai-notice-close{display:flex;align-items:center;justify-content:center;flex:0 0 30px;width:30px;height:30px;padding:0;border:0;border-radius:6px;background:transparent;color:inherit;font-size:22px;line-height:1}.kai-notice .kai-notice-close:hover{background:#14284e12}\n[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(max-width:700px){:where(.workspace-header,.kai-workspace-header){padding-inline:18px;min-height:65px;height:65px}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}\n","style.css":"/* Connections uses the original companion workspace rail and catalog. */\n:root{--line:#dce5f2;--panel:#fff;--muted:#61728d;--accent:#155eef;--danger:#c93d4c;color-scheme:light}body{margin:0;background:#f4f7fd;color:#14284e;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif}*{box-sizing:border-box}main{min-width:0}.workspace-header{height:74px;padding:0 34px;display:flex;align-items:center;justify-content:space-between;gap:15px;border-bottom:1px solid var(--line);background:#f4f7fd}.workspace-name{display:flex;align-items:center;gap:11px}.workspace-name svg{width:21px;height:21px;fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round}.workspace-header h1{font-size:15px;font-weight:650;margin:0}.workspace-page{padding:28px 34px 40px}.hub-shell{display:grid;grid-template-columns:174px minmax(0,1fr);gap:24px;align-items:start}.hub-rail{position:sticky;top:18px;display:flex;flex-direction:column;gap:5px;border-right:1px solid var(--line);padding-right:15px;min-width:0}.hub-rail-label{font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:8px 10px 15px;color:var(--muted)}.hub-rail button{background:transparent;border:0;text-align:left;min-height:39px;padding:10px 12px;color:var(--muted);border-radius:9px;font-size:12px}.hub-rail button[aria-selected=\"true\"]{background:#eaf2ff;color:var(--accent);font-weight:650}.hub-content{min-width:0}.hub-content>section{min-width:0}button,input,textarea,select{font:inherit}button{border:1px solid var(--line);border-radius:9px;background:#fff;color:#14284e;padding:8px 12px;font-size:12px;cursor:pointer}button:hover:enabled{background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:650}.primary:hover:enabled{background:#0c4ed3;border-color:#0c4ed3}.danger{color:var(--danger)}input,select,textarea{width:100%;min-width:0;border:1px solid var(--line);border-radius:9px;padding:10px 12px;background:#fff;color:#14284e;font-size:12px}textarea{resize:vertical;min-height:80px}label{font-size:12px;color:var(--muted)}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}h2{font-size:20px;line-height:1.4;letter-spacing:-.3px;font-weight:600;margin:0 0 10px}h3{font-size:15px;line-height:1.5;margin:0 0 10px}p{font-size:12px;line-height:1.7;margin:0 0 14px}.muted,.note{color:var(--muted)}.note,.mini{font-size:11px}.note{margin-top:18px}.section-heading{margin:0 0 18px}.section-heading h2{font-size:17px;margin:0}.section-heading p{margin:7px 0 0}.spread{display:flex;justify-content:space-between;align-items:center;gap:15px}.actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.actions input{flex:1;min-width:160px}.panel,.card{min-width:0;background:#fff;border:1px solid var(--line);border-radius:15px;padding:22px;margin-bottom:18px}.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,280px),1fr));gap:16px}.cards .card{margin:0}.grid{display:grid;grid-template-columns:1.2fr 1fr;gap:18px;align-items:start}.stack{display:flex;flex-direction:column;gap:16px}.stack label:not(.check){display:flex;flex-direction:column;gap:7px}.stack p,.stack h2{margin:0}.check{display:flex;align-items:flex-start;gap:10px;font-size:12px}.check input{width:16px;height:16px;flex:none;margin:3px 0 0;padding:0;accent-color:var(--accent)}.pill,.status{display:inline-flex;padding:4px 9px;border:1px solid var(--line);background:#fff;border-radius:30px;font-size:10px;color:var(--muted);white-space:nowrap}.status.connected{background:#eaf8f1;color:#168469;border-color:#cae9d9}.cn-hero{padding:22px 24px;margin-bottom:18px;border:1px solid #dce7f6;background:#eef4ff;border-radius:16px;display:flex;align-items:center;justify-content:space-between;gap:20px}.cn-hero h2{font-size:24px;letter-spacing:-.6px;margin:0 0 9px}.cn-hero p{margin:0;color:var(--muted)}.cn-route{display:flex;align-items:center;gap:7px;flex-shrink:0;font-size:10px;color:var(--muted)}.route-dot{width:6px;height:6px;border-radius:50%;background:#168469}.text-button{border:0;background:transparent;color:var(--accent);padding:5px;font-size:10px}.cn-searchbar{display:flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:11px;background:#fff;padding:7px 10px;margin-bottom:15px}.cn-searchbar svg{width:19px;height:19px;fill:none;stroke:#61728d;stroke-width:1.7;flex:none}.cn-searchbar input{border:0;background:none;padding:7px 3px;flex:1}.cn-searchbar button{padding:6px 11px}.cn-categories{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:22px}.cn-categories label{display:flex;flex-direction:column;gap:7px;min-width:160px;font-size:11px}.app-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(135px,1fr));gap:12px}.app-card{display:flex;align-items:center;flex-direction:column;gap:10px;min-height:166px;padding:18px 10px;background:#fff;border-radius:14px;text-align:center}.app-card:hover:enabled{border-color:#8bb4f3;background:#fff;box-shadow:0 5px 18px #173b6a09}.app-card strong{font-size:13px;line-height:1.4;min-height:36px;display:flex;align-items:center;justify-content:center;overflow-wrap:anywhere}.app-logo{width:42px;height:42px;flex:none;border:1px solid #e2eaf5;border-radius:12px;background:#fff;display:grid;place-items:center;font-weight:700;color:var(--accent);font-size:23px}.app-logo img{width:29px;height:29px;object-fit:contain}.app-auth{font-size:9px;color:var(--muted)}.app-connect{font-size:10px;color:var(--accent);margin-top:auto}.readiness{padding:14px 16px;border:1px solid #d9e5f6;background:#fff;border-radius:12px;margin:0 0 18px;display:flex;align-items:center;justify-content:space-between;gap:15px}.readiness p{margin:0;color:var(--muted)}.readiness button{flex:none;font-size:11px}.empty{grid-column:1/-1;padding:40px 24px;border:1px dashed #cbdcf1;border-radius:15px;text-align:center;color:var(--muted);font-size:12px;background:#ffffff70}.empty h3{font-size:19px;color:#14284e}.empty p{margin:0}.account-card h3{margin-top:18px}.account-card>.muted{overflow-wrap:anywhere}.account-card .actions{margin-top:18px}.account-card .actions button{font-size:11px;padding:7px 10px}#more-apps{display:block;margin:22px auto 0}.provider-options{display:grid;grid-template-columns:1fr 1fr;gap:12px}.provider-option{border:1px solid var(--line);border-radius:14px;padding:20px;position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:12px!important;cursor:pointer}.provider-option:has(input:checked){border-color:#4387f5;box-shadow:0 0 0 2px #4387f514}.provider-option input{position:absolute;top:18px;right:18px;width:16px;height:16px;accent-color:var(--accent)}.provider-icon{width:36px;height:36px;display:grid;place-items:center;background:var(--accent);color:white;border-radius:10px;font-weight:750;font-size:21px}.provider-icon.personal{background:#252932}.provider-option strong{font-size:15px;color:#14284e}.provider-option>span:last-child{font-size:11px;color:var(--muted)}#settings>.grid{grid-template-columns:1fr}#settings>.grid>.panel:last-child{background:transparent;border:0;padding:0 3px}#provider-status{font-size:11px}.tool-list{max-height:420px;overflow:auto}.tool-list .check{padding:13px;border:1px solid var(--line);border-radius:10px;margin-bottom:9px}.tool-list small{font-size:10px;color:var(--muted)}pre{max-height:440px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;padding:15px;border:1px solid var(--line);border-radius:10px;background:#f5f8fe;font:11px/1.7 Consolas,monospace}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}dialog{width:min(520px,calc(100vw - 36px));max-height:calc(100dvh - 36px);overflow:auto;border:1px solid var(--line);border-radius:18px;padding:26px;background:#f9fbff;color:#14284e;box-shadow:0 24px 90px #18304f26}dialog::backdrop{background:#122c4b55}dialog>.spread{margin-bottom:23px}dialog h2{font-size:20px;margin:0}.close-button{font-size:23px;padding:0;width:32px;height:32px;line-height:1;border:0;background:transparent}#app-dialog-icon{margin-bottom:18px}#app-dialog-icon .app-logo{width:58px;height:58px;border-radius:16px}#app-dialog-icon img{width:38px;height:38px}.connect-steps{padding-left:22px;color:var(--muted);font-size:12px;line-height:1.7}.connect-steps li{padding-left:6px;margin:15px 0}[hidden]{display:none!important}@media(max-width:1100px){.hub-shell{grid-template-columns:150px minmax(0,1fr);gap:18px}.grid{grid-template-columns:1fr}.cn-hero{align-items:flex-start;flex-direction:column;gap:13px}.cn-hero h2{font-size:23px}}@media(max-width:780px){.workspace-header{padding:0 22px}.workspace-page{padding:22px}.hub-shell{grid-template-columns:120px minmax(0,1fr);gap:12px}.hub-rail{padding-right:8px}.hub-rail button{padding:10px 9px;font-size:11px}.hub-rail-label{padding:8px 4px 12px;font-size:9px}.app-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.cn-hero{padding:17px}.cn-hero h2{font-size:20px}.cn-categories label{min-width:0;flex:1}.readiness{align-items:flex-start;flex-direction:column}.spread{flex-wrap:wrap}.provider-options{grid-template-columns:1fr}.panel{padding:18px}}@media(max-width:530px){.workspace-page{padding:18px 12px}.workspace-header{padding:0 14px}.hub-shell{grid-template-columns:100px minmax(0,1fr);gap:8px}.hub-rail button{font-size:10px;padding:9px 6px}.app-grid{grid-template-columns:1fr}.cn-categories{flex-direction:column}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"pWO8NQLh0Fez9O2I4zhYm4OGzz5cf7BqDAqdOefmmLKuDomf9DHIFaBRgnnnkzWOoAFJKaUUVTCPi/WyGrIRAA=="}