lt;opacity:1}\n/* Product pages use one natural document flow and one scrollbar. A flex child\n   must not shrink the sharing panel to make room for account history. */\n.product-v2 #main{min-height:0;overflow:clip}\n.product-v2 .workspace-header{flex:0 0 auto}\n.product-v2 .product-page,.product-v2 #view-earn{display:block;flex:1 1 0;height:auto;min-height:0;overflow:auto;overscroll-behavior:contain;scrollbar-gutter:stable}\n.product-v2 .product-earn{overflow:visible}\n.product-v2 .product-head,.product-v2 .product-panel,.product-v2 .product-two{flex-shrink:0}\n.product-v2 #product-legacy-account{margin:26px 0 0;padding:18px 0;border-top:1px solid var(--border)}\n.product-v2 #product-legacy-account>summary{font-size:12px;line-height:1.5}\n.product-v2 #product-legacy-account>.api-card{padding:22px 0;max-width:none;width:100%;overflow:visible}\n.product-v2 #product-wallet-controls{max-width:900px}\n.product-v2 #product-wallet-controls h2{margin:22px 0 12px}\n.product-v2 #product-wallet-controls .hint{line-height:1.6;margin:10px 0}\n.product-v2 #product-wallet-controls .form-row{margin:12px 0;flex-wrap:wrap}\n.product-v2 #product-wallet-controls input{min-width:0}\n.product-v2 #product-wallet-controls .snippet{overflow-wrap:anywhere;white-space:pre-wrap}\n.product-v2 #product-provider-readiness{margin-top:8px}\n.product-v2 #product-provider-label{font-size:clamp(25px,2.5vw,38px);overflow-wrap:anywhere}\n.product-v2 #product-provider-label[data-state=\"online\"]{font-size:clamp(32px,3vw,46px)}\n.product-v2 #product-completed-count[data-unreported=\"true\"]{font-size:25px;letter-spacing:-.5px}\n\n.product-v2 .product-two.product-single{grid-template-columns:1fr}\n.product-v2 #network-model-price{font-size:10px;color:var(--text-dim);overflow-wrap:anywhere}\n\n.product-v2 #product-provider-check h3{font-size:13px;margin:20px 0 8px}\n.product-v2 #product-provider-check progress{width:100%;height:9px;accent-color:var(--violet)}\n.product-v2 #product-provider-check .product-