 L 179.94 143.85\n  A 4.70 4.70 0.0 0 1 176.94 139.59\n  Q 176.71 129.83 177.00 125.35\n  C 177.23 121.88 175.70 120.00 173.06 118.67\n  C 169.94 117.09 166.55 119.45 165.19 122.26\n  Q 164.45 123.78 164.50 127.35\n  Q 164.61 134.14 164.49 138.94\n  A 5.60 5.60 0.0 0 1 161.69 143.65\n  L 160.37 144.41\n  A 1.90 1.90 0.0 0 1 157.53 142.60\n  Q 157.96 137.88 157.74 126.00\n  C 157.57 116.28 165.31 109.82 174.80 112.06\n  C 176.45 112.45 178.22 114.21 179.61 115.12\n  A 1.03 1.03 0.0 0 0 180.75 115.12\n  C 184.42 112.71 187.87 110.66 192.43 111.92\n  Q 202.60 114.74 202.79 126.24\n  Q 202.96 137.15 202.73 142.76\n  A 2.03 2.03 0.0 0 1 199.53 144.34\n  Z\"\n/>\n<path fill=\"#ffffff\" d=\"\n  M 82.53 119.35\n  L 64.65 137.42\n  A 0.47 0.47 0.0 0 0 64.98 138.22\n  L 79.80 138.22\n  A 4.09 4.08 75.0 0 1 83.34 140.27\n  L 84.88 142.93\n  A 1.50 1.49 -14.8 0 1 83.57 145.17\n  Q 71.98 145.08 59.37 144.98\n  Q 57.20 144.96 54.69 141.93\n  Q 53.67 139.16 56.07 136.80\n  Q 68.74 124.31 72.06 120.82\n  Q 72.64 120.21 72.89 119.77\n  A 0.90 0.90 0.0 0 0 72.06 118.44\n  Q 66.86 118.65 62.77 118.67\n  C 58.90 118.69 54.88 117.52 54.62 113.10\n  A 1.14 1.13 88.1 0 1 55.75 111.89\n  Q 68.00 111.88 77.73 112.05\n  Q 81.82 112.12 82.87 115.12\n  Q 83.40 116.63 82.53 119.35\n  Z\"\n/>\n<circle fill=\"#0e5efe\" cx=\"101.76\" cy=\"128.54\" r=\"10.18\"/>\n<ellipse fill=\"#0e5efe\" cx=\"0.00\" cy=\"0.00\" transform=\"translate(137.91,128.53) rotate(-132.4)\" rx=\"10.26\" ry=\"10.10\"/>\n<path fill=\"#0a53e5\" d=\"\n  M 86.55 121.01\n  C 83.48 127.64 84.61 134.42 89.49 139.69\n  C 92.20 142.62 94.70 144.35 98.77 145.31\n  C 105.33 148.49 111.98 151.56 118.43 155.01\n  Q 142.42 167.88 173.51 183.70\n  Q 192.28 193.26 210.31 206.79\n  Q 192.40 225.71 168.23 231.23\n  Q 153.74 234.55 135.22 235.05\n  Q 93.64 208.76 54.70 187.06\n  Q 42.51 180.26 27.37 173.72\n  Q 25.22 166.80 24.05 158.50\n  Q 21.82 142.73 21.81 128.09\n  C 34.13 129.34 44.47 134.98 54.69 141.93\n  Q 57.20 144.96 59.37 144.98\n  Q 71.98 145.08 83.57 145.17\n  A 1.50 1.49 -14.8 0 0 84.88 142.93\n  L 83.34 140.27\n  A 4.09 4.08 75.0 0 0 79.80 138.22\n  L 64.98 138.22\n  A 0.47 0.47 0.0 0 1 64.65 137.42\n  L 82.53 119.35\n  Q 84.48 119.68 86.55 121.01\n  Z\"\n/>\n<path fill=\"#094acb\" d=\"\n  M 135.22 235.05\n  Q 110.75 235.90 89.55 231.43\n  Q 78.68 229.14 67.27 222.70\n  Q 43.33 209.17 31.34 184.39\n  Q 30.32 182.27 27.37 173.72\n  Q 42.51 180.26 54.70 187.06\n  Q 93.64 208.76 135.22 235.05\n  Z\"\n/>\n</svg>","brain.css":"/* Companion workspaces follow the Koinos Node rail and pane layout. */\n.hub-shell{display:grid;grid-template-columns:174px minmax(0,1fr);gap:24px;align-items:start}\n.hub-rail{position:sticky;top:18px;display:flex;flex-direction:column;gap:5px;border-right:1px solid var(--border);padding-right:15px;min-width:0}\n.hub-rail-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--text-dim);padding:8px 10px 16px}\n.hub-rail button{border:0;background:transparent;color:var(--text-dim);text-align:left;padding:11px 12px;min-height:40px}\n.hub-rail button.active{background:var(--bg-raised);color:var(--text);box-shadow:inset 3px 0 var(--violet)}\n.hub-content{min-width:0}.bn-workspace{min-width:0}.bn-main>.hub-panel,.bn-main>form,.bn-source-add{margin-bottom:18px}\n.bn-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin:0 0 22px}\n.bn-heading h2{font-size:23px;letter-spacing:-.025em;margin:0 0 8px;line-height:1.25}.bn-heading p{font-size:13px;color:var(--text-dim);line-height:1.6;max-width:600px;margin:0}.bn-heading .hub-actions{margin:0}\n.bn-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:22px}\n.bn-stats>div{border:1px solid var(--border);border-radius:12px;padding:18px;background:var(--bg-raised);display:flex;flex-direction:column;gap:6px}\n.bn-stats b{font-size:25px;font-weight:600;letter-spacing:-.03em;overflow-wrap:anywhere}.bn-stats span{font-size:11px;color:var(--text-dim)}\n.bn-overview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-bottom:28px}\n.bn-prose{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;font-size:13px;line-height:1.7;color:var(--text-dim);max-height:430px;overflow:auto;margin:12px 0}\n.bn-memory p{display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}\n.bn-heatmap{display:grid;grid-template-columns:repeat(28,minmax(0,1fr));gap:5px}.bn-heatmap>div{aspect-ratio:1;border-radius:4px;background:var(--bg-raised);border:1px solid var(--border)}.bn-heatmap .has-data{background:var(--violet);opacity:var(--level)}.bn-heatmap span{font-size:0}\n.bn-filters{display:grid;grid-template-columns:2fr 1.3fr 1.3fr 1fr;gap:10px;margin-bottom:18px}.bn-filters input,.bn-filters select{min-width:0;width:100%}\n.bn-graph{background:var(--bg-raised);border:1px solid var(--border);border-radius:12px;margin-bottom:22px;padding:14px}.bn-graph svg{display:block;width:100%;max-height:410px}.bn-graph path{fill:none;stroke:var(--violet);stroke-opacity:.24;stroke-width:1.2}.bn-graph circle{fill:var(--violet)}.bn-graph circle.source{fill:var(--text-dim)}.bn-graph text{fill:var(--text);font-size:11px}.bn-graph g{cursor:pointer}.bn-graph g:focus circle{stroke:var(--text);stroke-width:3}.bn-graph .hub-help{margin:8px 5px 0}\n.bn-modes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:18px}.bn-mode{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding:20px;border:1px solid var(--border);border-radius:12px;background:var(--bg-raised);cursor:pointer}.bn-mode:has(input:checked){border-color:var(--violet);box-shadow:inset 0 0 0 1px var(--violet)}.bn-mode strong{font-size:16px}.bn-mode span{font-size:12px;color:var(--text-dim);line-height:1.6}\n.bn-workspace input[type=checkbox],.bn-workspace input[type=radio]{width:16px;min-width:16px;max-width:16px;height:16px;margin:0;flex:none;accent-color:var(--violet)}\n.bn-workspace .hub-check{align-items:flex-start;gap:10px;line-height:1.6;margin:12px 0}.bn-workspace .hub-field input,.bn-workspace .hub-field select,.bn-workspace .hub-field textarea{width:100%;min-width:0;max-width:100%}.bn-workspace .hub-field textarea{min-height:90px}.bn-workspace .hub-panel h3{margin:0 0 14px}.bn-workspace .hub-panel+.hub-panel{margin-top:16px}\n.bn-source-checks{max-height:250px;overflow:auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:0 18px}.bn-source-checks .hub-check{margin:8px 0}.bn-source-grid{margin-top:20px}.bn-source-add summary{font-weight:600;cursor:pointer;padding:4px}.bn-source-add form{margin-top:22px}\n.bn-job-list,.bn-changes{display:flex;flex-direction:column;gap:10px}.bn-job-list summary{display:flex;align-items:center;justify-content:space-between;gap:15px;cursor:pointer}.bn-job-list summary small{display:block;margin-top:6px}.bn-changes summary{cursor:pointer;line-height:1.8}.bn-changes summary small{margin-left:10px}.bn-diff{display:grid;grid-template-columns:1fr 1fr;gap:20px}.bn-diff section{min-width:0}.bn-diff section+section{border-left:1px solid var(--border);padding-left:20px}\n.bn-pipeline{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 22px}.bn-pipeline span{border:1px solid var(--border);background:var(--bg-raised);border-radius:18px;padding:8px 13px;font-size:11px;color:var(--text-dim)}\n.cn-categories{display:flex;gap:12px;flex-wrap:wrap}.cn-category-picker{max-width:250px;flex:1;min-width:150px}.cn-category-picker select{min-width:0;width:100%}\n.cn-app-grid{grid-template-columns:repeat(auto-fill,minmax(135px,1fr));gap:12px}\n.cn-workspace .cn-app-card{min-height:166px;padding:18px 10px;align-items:center;text-align:center;gap:10px;display:flex;flex-direction:column;justify-content:flex-start}\n.cn-workspace .cn-app-card>strong{font-size:13px;line-height:1.4;margin:0;overflow-wrap:anywhere;min-height:36px;display:flex;align-items:center;justify-content:center}\n.cn-app-card .cn-logo{width:40px;height:40px;margin:0 auto}.cn-auth-label{font-size:10px;color:var(--text-dim);line-height:1.4}.cn-card-footer{margin-top:auto;padding-top:5px;border:0;justify-content:center;width:100%}.cn-card-footer b{font-size:10px}.cn-list-heading span{font-size:11px}\n@media(max-width:1100px){.hub-shell{grid-template-columns:150px minmax(0,1fr);gap:18px}.bn-filters{grid-template-columns:1fr 1fr}.bn-overview-grid{grid-template-columns:1fr}.bn-stats{grid-template-columns:1fr 1fr}.bn-modes{gap:8px}.bn-mode{padding:14px}.cn-hero{padding:20px}.cn-hero h2{font-size:23px}}\n@media(max-width:780px){.hub-shell{grid-template-columns:120px minmax(0,1fr);gap:12px}.hub-rail{padding-right:8px}.hub-rail button{padding:10px 9px;font-size:11px}.hub-rail-label{padding:8px 4px 12px;font-size:9px}.bn-heading h2{font-size:20px}.bn-modes{grid-template-columns:1fr}.bn-mode{display:grid;grid-template-columns:16px 1fr;gap:8px 12px}.bn-mode span{grid-column:2}.bn-stats>div{padding:12px}.bn-stats b{font-size:21px}.bn-filters{grid-template-columns:1fr}.bn-diff{grid-template-columns:1fr}.bn-diff section+section{padding:0;border:0}.cn-app-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.cn-workspace .cn-app-card{min-height:164px;padding:14px 8px}.cn-workspace .cn-hero h2{font-size:20px}.cn-hero{padding:16px}.bn-heatmap{gap:3px;grid-template-columns:repeat(14,minmax(0,1fr))}.hub-content .hub-card{padding:16px}}\n@media(max-width:530px){.hub-shell{grid-template-columns:100px minmax(0,1fr);gap:8px}.hub-rail button{font-size:10px;padding:9px 6px}.bn-stats{gap:7px}.cn-app-grid{grid-template-columns:1fr}.hub-header{gap:10px}.hub-header>.hub-badge{display:none}}\n\n/* The app already supplies the workspace heading; keep catalog controls compact. */\n.cn-hero{padding:22px 24px;margin-bottom:18px}.cn-hero h2{font-size:24px;margin:8px 0 10px}.cn-hero p{margin-bottom:0}.cn-kicker{display:none}.cn-category-picker{display:flex;flex-direction:column;align-items:stretch;gap:7px;min-width:150px}.cn-categories{margin-bottom:20px}.cn-hero .cn-route{flex-shrink:0}\n.bn-workspace button:not(.primary),.hub-card .hub-actions button:not(.primary),.hub-content>.hub-toolbar button:not(.primary){appearance:none;background:var(--bg-raised);color:var(--text);border:1px solid var(--border);box-shadow:none}.bn-workspace button:not(.primary):hover,.hub-card .hub-actions button:not(.primary):hover{border-color:var(--violet);color:var(--violet)}\n","brand-mark.svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\"><defs><linearGradient id=\"blue\" x2=\".8\" y2=\"1\"><stop stop-color=\"#03cefa\"/><stop offset=\"1\" stop-color=\"#0856f9\"/></linearGradient></defs><g fill=\"none\" stroke=\"url(#blue)\" stroke-width=\"11\" stroke-linecap=\"round\"><path d=\"M11 10v7M11 38V28L35 9M26 29l12 10\"/></g></svg>\n","companion-client.js":"\"use strict\";\n(() => {\n  const bridge = window.kaiCompanionBridge;\n  async function checked(promise) { const out = await promise; if (!out?.ok) throw new Error(out?.error || \"Companion unavailable.\"); return out.result; }\n  // Only final replies receive automatic recall. Planning accesses Brain with\n  // explicit private tools, so ordinary web research never starts with notes.\n  async function enrich(body, signal) {\n    if (!body.model) return body;\n    signal?.throwIfAborted();\n    const query = [...(body.messages || [])].reverse().find(m => m.role === \"user\" && typeof m.content === \"string\")?.content || \"\";\n    const final = body.stream !== false;\n    const out = bridge ? await checked(bridge.context(body.model, final ? query.slice(0, 500) : null)) : { eligible: false };\n    signal?.throwIfAborted();\n    const next = out.eligible ? { ...body, kai_private_desktop: true } : { ...body };\n    const notes = final && out.eligible && out.context ? [out.context.slice(0, 2400)] : [];\n    signal?.throwIfAborted();\n    if (notes.length) next.messages = [{ role: \"system\", content: notes.join(\"\\n\\n\") }, ...(body.messages || [])];\n    return next;\n  }\n  function toolJSON(model, fallback, signal, context = {}) {\n    let privateUsed = false, privateTools = [], session = null, stopped = false, lastState = null;\n    const panel = context.host && document.createElement(\"details\");\n    if (panel) { panel.className = \"kai-action-results\"; panel.hidden = true; context.host.append(panel); }\n    function paint(state) {\n      if (!panel || (!state?.actions?.length && !state?.plans?.length)) return;\n      panel.hidden = false; const opened = panel.open; panel.replaceChildren();\n      const summary = document.createElement(\"summary\"); summary.textContent = \"KAI actions · \" + state.actions.length; panel.append(summary); panel.open = opened;\n      for (const plan of state.plans || []) { const p = document.createElement(\"p\"); p.textContent = plan.name + \": \" + plan.steps.join(\" → \"); panel.append(p); }\n      for (const action of state.actions) {\n        const row = document.createElement(\"div\"), title = document.createElement(\"strong\"), detail = document.createElement(\"p\");\n        title.textContent = action.name; detail.textContent = action.runStatus || action.status;\n        row.append(title, detail);\n        if (action.message) { const message = document.createElement(\"p\"); message.textContent = action.message; row.append(message); }\n        for (const link of action.links || []) { try { const u = new URL(link); if (u.protocol !== \"https:\" || u.username || u.password) continue; const a = document.createElement(\"a\"); a.href = u.href; a.target = \"_blank\"; a.rel = \"noopener noreferrer\"; KaiI18n.setText(a, \"Open result ↗\"); row.append(a); } catch {} }\n        panel.append(row);\n      }\n    }\n    async function refresh() { if (session && !stopped) try { lastState = await checked(bridge.session(\"status\", { id: session.id, model })); paint(lastState); } catch {} }\n    let timer;\n    async function finish() { signal?.removeEventListener(\"abort\", cancel); clearInterval(timer); if (!session || stopped) return; await refresh(); stopped = true; await bridge.session(\"finish\", { id: session.id, cancel: !!signal?.aborted }).catch(() => {});\n      if (panel && bridge.activity && !signal?.aborted && lastState?.actions?.some(a => [\"running\", \"waiting\"].includes(a.runStatus))) {\n        let polls = 0;\n        const watch = setInterval(async () => {\n          if (!panel.isConnected || signal?.aborted || ++polls > 600) { clearInterval(watch); return; }\n          try { const turns = await checked(bridge.activity(model, context.conversationId || \"main\")); const state = turns.find(t => t.id === session.id); paint(state); if (!state?.actions.some(a => [\"running\", \"waiting\"].includes(a.runStatus))) clearInterval(watch); } catch { clearInterval(watch); }\n        }, 2000);\n      }\n    }\n\n    const cancel = () => bridge?.cancel().catch(() => {});\n    signal?.addEventListener(\"abort\", cancel, { once: true });\n    const json = async (url, options = {}) => {\n      signal?.throwIfAborted();\n      if (!bridge) return fallback(url, options);\n      if (url === \"/core/tools\") {\n        const [core, extra] = await Promise.all([fallback(url, options), checked(bridge.tools(model))]);\n        privateTools = extra;\n        const canSession = bridge.session && context.question;\n        const active = canSession ? extra.filter(t => !t.name.startsWith(\"connection_\")) : extra.filter(t => !t.conversationAction);\n        privateTools = active;\n        return { ...core, tools: [...(core.tools || []).filter(t => !/^memory_(save|search)$/.test(t.name)), ...active] };\n      }\n      if (url === \"/core/tools/call\") {\n        const call = JSON.parse(options.body);\n        if (privateTools.some(t => t.name === call.name)) {\n          if (privateTools.find(t => t.name === call.name)?.conversationAction && !session) {\n            session = await checked(bridge.session(\"begin\", { model, question: context.question.slice(0, 4000), conversationId: context.conversationId || \"main\" }));\n            signal?.throwIfAborted();\n          }\n          privateUsed = true;\n          context.onPrivateTool?.(true, call.name);\n          try { if (session && panel) timer = setInterval(refresh, 1500); const result = await checked(bridge.tool(call.name, call.args, model, session?.id)); signal?.throwIfAborted(); await refresh(); return { ok: true, result: typeof result === \"string\" ? result : JSON.stringify(result) }; }\n          catch (e) { await refresh(); signal?.throwIfAborted(); if (/declined|uncertain|already stopped/.test(e.message)) { const error = new Error(e.message); error.stopTools = true; throw error; } throw e; }\n          finally { if (timer) clearInterval(timer); context.onPrivateTool?.(false, call.name); }\n        }\n        // Once private observations enter the planner, it cannot forward them\n        // to a web/MCP/Core tool. Further private connection calls ask natively.\n        if (privateUsed) throw new Error(\"Private Brain or connection data is in this turn. Use connected_research for a reviewed public query/page; other Core/MCP tools require a separate request.\");\n      }\n      return fallback(url, options);\n    };\n    json.finish = finish;\n    return json;\n  }\n  window.KaiCompanionClient = { enrich, toolJSON, checked };\n})();\n","companion-hub.js":"\"use strict\";\n(() => {\n  const bridge = window.kaiCompanionBridge, client = window.KaiCompanionClient;\n  const esc = s => String(s ?? \"\").replace(/[&<>\"']/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" })[c]);\n  const date = n => n ? new Date(n).toLocaleString([], { dateStyle: \"medium\", timeStyle: \"short\" }) : \"Never\";\n  const button = (label, action, id = \"\", cls = \"\") => KaiI18n.html`<button type=\"button\" class=\"${cls}\" data-hub-action=\"${action}\" data-id=\"${esc(id)}\" data-i18n=\"${esc(label)}\">${esc(label)}</button>`;\n  const field = (label, input, full = false) => KaiI18n.html`<label class=\"hub-field ${full ? \"hub-full\" : \"\"}\"><span data-i18n=\"${esc(label)}\">${label}</span>${input}</label>`;\n  const input = (name, value = \"\", placeholder = \"\") => KaiI18n.html`<input name=\"${name}\" value=\"${esc(value)}\" placeholder=\"${esc(placeholder)}\"/>`;\n  const area = (name, value = \"\", rows = 4) => KaiI18n.html`<textarea name=\"${name}\" rows=\"${rows}\">${esc(value)}</textarea>`;\n  const select = (name, values, selected) => KaiI18n.html`<select name=\"${name}\">${values.map(v => { const [key, label] = Array.isArray(v) ? v : [v, v]; return KaiI18n.html`<option value=\"${esc(key)}\" ${key === selected ? \"selected\" : \"\"}>${esc(label)}</option>`; }).join(\"\")}</select>`;\n  const check = (name, label, value) => KaiI18n.html`<label class=\"hub-check\"><input name=\"${name}\" type=\"checkbox\" ${value ? \"checked\" : \"\"}/><span data-i18n=\"${esc(label)}\">${label}</span></label>`;\n  const empty = (title, detail) => KaiI18n.html`<div class=\"hub-empty\"><strong data-i18n=\"${esc(title)}\">${title}</strong><p data-i18n=\"${esc(detail)}\">${detail}</p></div>`;\n  let state, current = \"brain\", tab = { brain: \"overview\", workflows: \"saved\", connections: \"explore\" }, timer, editor = null, busy = false;\n  const host = () => document.getElementById(\"view-\" + current);\n  const manage = (action, value) => client.checked(bridge.manage(action, value));\n  const childManage = async (action, input) => { const result = await manage(action, input); if (action === \"status\") state = result; return result; };\n  const value = (form, name) => form.elements.namedItem(name)?.value || \"\";\n  const bool = (form, name) => form.elements.namedItem(name)?.checked === true;\n  const json = (form, name, fallback = {}) => { const s = value(form, name).trim(); try { return s ? JSON.parse(s) : fallback; } catch { throw new Error(`Enter valid JSON for ${name}.`); } };\n  function note(message, error = false) { const n = host()?.querySelector(\".hub-notice\"); if (n) { n.textContent = message; n.classList.toggle(\"error\", error); } }\n  async function refresh() { state = await manage(\"status\"); }\n  function shell() {\n    const titles = { brain: [\"KAI Brain\", \"A memory of your world, built from what you choose to share.\"], workflows: [\"Workflows\", \"Teach KAI a routine. Review the steps, then run it whenever you need.\"], connections: [\"Connections\", \"Connect the apps you use and choose what KAI can do with them.\"] };\n    const tabs = { brain: [[\"overview\", \"Overview\"], [\"map\", \"Memory graph\"], [\"notes\", \"Memories\"], [\"goals\", \"Goals & tasks\"], [\"sources\", \"Sources\"], [\"sync\", \"Sync & changes\"], [\"awareness\", \"Awareness\"], [\"orchestration\", \"Orchestration\"]], workflows: [[\"saved\", \"My workflows\"], [\"runs\", \"Run history\"], [\"templates\", \"Templates\"], [\"discover\", \"Discover workflows\"]], connections: [[\"explore\", \"Explore apps\"], [\"connected\", \"Connected\"], [\"setup\", \"Connection settings\"], [\"apis\", \"Custom APIs\"], [\"tools\", \"Models & other tools\"]] };\n    host().innerHTML = KaiI18n.html`<div class=\"hub-notice\" role=\"status\" aria-live=\"polite\"></div><div class=\"hub-shell\"><nav class=\"hub-rail\" aria-label=\"${current} sections\"><div class=\"hub-rail-label\">${titles[current][0]}</div>${tabs[current].map(([key, label]) => button(label, \"tab\", key, key === tab[current] ? \"active\" : \"\")).join(\"\")}</nav><main class=\"hub-content\"></main></div>`;\n  }\n  function draw() {\n    shell(); const out = host().querySelector(\".hub-content\");\n    if (!bridge) { out.innerHTML = empty(\"Open the installed KAI desktop app\", \"Brain, private API connections, and durable workflows are available in Koinos AI Test.\"); return; }\n    if (state.locked) { out.innerHTML = empty(\"Your companion data is locked\", \"Unlock secure OS storage and reopen this app. Saved plugin data has been preserved.\"); return; }\n    if (editor) { out.innerHTML = editorHTML(); return; }\n    if (current === \"brain\") window.KaiBrain.render(out, { state, section: tab.brain, manage: childManage, navigate: async key => { await refresh(); return action(\"tab\", key); } });\n    if (current === \"workflows\") window.KaiWorkflows.render(out, { state, section: tab.workflows, manage: childManage, navigate: async key => { await refresh(); return action(\"tab\", key); } });\n    if (current === \"connections\") drawConnections(out);\n  }\n  function drawWorkflows(out) {\n    if (tab.workflows === \"runs\") {\n      out.innerHTML = KaiI18n.html`<p class=\"hub-help\">Runs keep a checkpoint after each completed step. A paused run waits for you. After an interrupted external action, inspect the destination before starting another run.</p><div class=\"hub-run-list\">${state.runs.map(r => KaiI18n.html`<details class=\"hub-card hub-run\" ${[\"waiting\", \"running\", \"interrupted\"].includes(r.status) ? \"open\" : \"\"}><summary><span><b>${esc(r.name)}</b><small>${date(r.startedAt)} · ${esc(r.trigger)}</small></span><span class=\"hub-badge ${r.status}\">${esc(r.status)}</span></summary><div class=\"hub-run-body\">${r.steps.map((s, i) => KaiI18n.html`<details><summary>${i + 1}. ${esc(s.label)} · ${esc(s.status)}</summary><pre>${esc(s.output)}</pre></details>`).join(\"\")}${r.pending ? KaiI18n.html`<div class=\"hub-pending\"><b>Waiting for approval · Step ${r.index + 1}</b><pre>${esc(JSON.stringify(r.pending, null, 2))}</pre></div>` : \"\"}${r.error ? KaiI18n.html`<p class=\"error\">${esc(r.error)}</p>` : \"\"}<div class=\"hub-actions\">${[\"waiting\", \"interrupted\"].includes(r.status) && !r.inFlight ? button(\"Review & resume\", \"resume\", r.id, \"primary\") : \"\"}${[\"running\", \"waiting\", \"interrupted\"].includes(r.status) ? button(\"Cancel run\", \"cancelRun\", r.id) : \"\"}</div></div></details>`).join(\"\") || empty(\"Your first run starts here\", \"Run a saved workflow to see its progress and results.\")}</div>`;\n      return;\n    }\n    out.innerHTML = KaiI18n.html`<div class=\"hub-toolbar\">${button(\"New workflow\", \"newWorkflow\", \"\", \"primary\")}${button(\"Import workflow\", \"importWorkflow\")}${button(\"Scheduled prompts\", \"legacyTasks\")}</div><p class=\"hub-help\">Schedules run while the desktop app is open. Reasoning steps use an installed local model. API actions use your saved connections; writes pause for approval.</p><div class=\"hub-grid\">${state.workflows.map(w => KaiI18n.html`<article class=\"hub-card\"><div class=\"hub-card-top\"><span class=\"hub-badge\">${w.draft ? \"Draft · review required\" : w.enabled ? w.schedule.kind === \"manual\" ? \"Manual\" : \"Schedule on\" : \"Schedule off\"}</span><small>${w.steps.length} steps</small></div><h3>${esc(w.name)}</h3><p>${esc(w.description || w.steps.map(s => s.label).join(\" → \"))}</p>${w.nextRunAt ? KaiI18n.html`<small>Next run ${date(w.nextRunAt)}</small>` : \"\"}<div class=\"hub-mini-flow\">${w.steps.slice(0, 5).map((s, i) => KaiI18n.html`<span>${i + 1}. ${esc(s.label)}</span>`).join(\"\")}</div><div class=\"hub-actions\">${!w.draft ? button(\"Run\", \"run\", w.id, \"primary\") : \"\"}${button(\"Edit\", \"editWorkflow\", w.id)}${button(\"Export\", \"exportWorkflow\", w.id)}${button(\"Delete\", \"deleteWorkflow\", w.id)}</div></article>`).join(\"\") || empty(\"Make room for the work you enjoy\", \"Start with a template below or describe the routine you want KAI to help with.\")}</div><h2 class=\"hub-section-title\">Start from a template</h2><div class=\"hub-grid\">${[[\"briefing\", \"Project briefing\", \"Search your Brain, summarize the latest context, and save a readable result.\"], [\"review\", \"Weekly goal review\", \"Review project notes, draft next steps, and pause before remembering them.\"], [\"api\", \"API digest\", \"Read a connection, summarize the response, and keep the result in run history.\"]].map(([key, title, detail]) => KaiI18n.html`<button class=\"hub-template\" data-hub-action=\"templateWorkflow\" data-id=\"${key}\"><strong>${title}<span>↗</span></strong><p>${detail}</p></button>`).join(\"\")}</div>`;\n  }\n  function drawConnections(out) {\n    if ([\"explore\", \"connected\", \"setup\"].includes(tab.connections) && window.KaiConnections) {\n      window.KaiConnections.render(out, { state, section: tab.connections, manage: childManage,\n        navigate: async section => { tab.connections = section; await refresh(); draw(); } }); return;\n    }\n    if (tab.connections === \"tools\") {\n      out.innerHTML = KaiI18n.html`<div class=\"hub-grid\"><article class=\"hub-card\"><h3>AI models</h3><p>Use your own OpenAI or Anthropic key in private desktop chat, or install a local model for private, scheduled work.</p>${button(\"Provider settings\", \"providerSettings\")}${button(\"Local model library\", \"modelLibrary\")}</article><article class=\"hub-card\"><h3>MCP, email & calendars</h3><p>KAI's existing tool servers, email accounts, and calendar connections are available in Tools with their current permissions.</p>${button(\"Open Tools\", \"legacyTools\")}</article></div>`;\n      return;\n    }\n    out.innerHTML = KaiI18n.html`<div class=\"hub-toolbar\"><p>Advanced connections using your own endpoints and tokens.</p>${button(\"Add connection\", \"newConnection\", \"\", \"primary\")}</div><div class=\"hub-grid\">${state.connections.filter(c => c.provider !== \"composio\").map(c => KaiI18n.html`<article class=\"hub-card\"><div class=\"hub-card-top\"><span class=\"hub-badge\">${c.enabled ? esc(c.status) : \"Disabled\"}</span><small>${c.operations.length} operations</small></div><h3>${esc(c.name)}</h3><p class=\"hub-url\">${esc(c.baseUrl)}</p><p>${c.allowAgent ? \"Available to KAI with scoped approval\" : \"Manual use only\"}<br/>${c.allowSync ? \"Background reads allowed\" : \"Background reads off\"}</p><div class=\"hub-actions\">${button(\"Open & test\", \"useConnection\", c.id, \"primary\")}${button(\"Edit\", \"editConnection\", c.id)}${button(\"Remove\", \"deleteConnection\", c.id)}</div></article>`).join(\"\") || empty(\"Connect a custom API\", \"Use Explore apps for simple sign-in, or configure an API here for a service you manage.\")}</div><h2 class=\"hub-section-title\">Start with an API template</h2><div class=\"hub-catalog\">${state.templates.map(t => button(t.name, \"connectionTemplate\", t.id)).join(\"\")}</div>`;\n  }\n  function editorHTML() {\n    const { kind, item } = editor;\n    const top = KaiI18n.html`<div class=\"hub-toolbar\">${button(\"← Back\", \"closeEditor\")}<h2>${esc({ note: item.sourceId ? \"Source content\" : \"Memory\", goal: \"Goal\", workflow: \"Workflow builder\", connection: \"API connection\", request: \"Use connection\", source: \"Add a Brain source\", run: \"Start workflow\" }[kind])}</h2></div>`;\n    if (kind === \"run\") return top + KaiI18n.html`<form data-hub-form=\"run\" class=\"hub-panel\"><h3>${esc(item.name)}</h3>${field(\"Run input (optional)\", area(\"input\", \"\", 4), true)}<p class=\"hub-help\">Use a project name or topic to fill {{input}} in the saved steps.</p><button class=\"primary\">Start run</button></form>`;\n    if (kind === \"note\") return top + KaiI18n.html`<form data-hub-form=\"note\" class=\"hub-panel\"><div class=\"hub-form-grid\">${field(\"Title\", input(\"title\", item.title), true)}${field(\"Category\", select(\"category\", [\"notes\", \"preferences\", \"people\", \"projects\"], item.category))}${field(\"Tags\", input(\"tags\", (item.tags || []).join(\", \"), \"Comma-separated\"))}${field(\"What should KAI know?\", area(\"text\", item.text, 9), true)}</div>${item.sourceId ? KaiI18n.html`<p>Imported from ${esc(item.source)}. Re-import or sync its source to update.</p>` : KaiI18n.html`${check(\"pinned\", \"Keep this note prominent in recall\", item.pinned)}<button class=\"primary\">Save memory</button>`}</form>`;\n    if (kind === \"goal\") return top + KaiI18n.html`<form data-hub-form=\"goal\" class=\"hub-panel\"><div class=\"hub-form-grid\">${field(\"Goal\", input(\"title\", item.title), true)}${field(\"Why it matters / next steps\", area(\"detail\", item.detail), true)}${field(\"Status\", select(\"status\", [\"active\", \"paused\", \"done\"], item.status))}${field(\"Priority\", select(\"priority\", [\"normal\", \"high\"], item.priority))}</div><button class=\"primary\">Save goal</button></form>`;\n    if (kind === \"connection\") return top + KaiI18n.html`<form data-hub-form=\"connection\" class=\"hub-panel\"><div class=\"hub-form-grid\">${field(\"Name\", input(\"name\", item.name))}${field(\"API base URL\", input(\"baseUrl\", item.baseUrl))}${field(\"Authentication\", select(\"auth\", [[\"bearer\", \"Bearer token\"], [\"header\", \"API-key header\"], [\"none\", \"No authentication\"]], item.auth))}${field(\"Secret header (header auth only)\", input(\"headerName\", item.headerName || \"X-API-Key\"))}${field(\"Your API token\", '<input type=\"password\" name=\"secret\" autocomplete=\"off\" placeholder=\"' + (item.id ? \"Saved securely · leave blank to keep\" : \"Paste your token\") + '\"/>', true)}</div><div class=\"hub-checks\">${check(\"enabled\", \"Enable connection\", item.enabled !== false)}${check(\"allowAgent\", \"Let KAI use these operations (review once or make an action always allowed)\", item.allowAgent)}${check(\"allowSync\", \"Allow saved sources and workflows to make background GET requests\", item.allowSync)}</div><details class=\"hub-advanced\" open><summary>API operations and version headers</summary><p class=\"hub-help\">Each operation has a unique id, name, HTTP method, and path. Use {owner}, {repo}, or other placeholders for request variables. Write methods require review unless you explicitly always allow that exact operation.</p>${field(\"Operations (JSON)\", area(\"operations\", JSON.stringify(item.operations, null, 2), 12), true)}${field(\"Version headers (JSON)\", area(\"headers\", JSON.stringify(item.headers || {}, null, 2), 3), true)}</details><button class=\"primary\">Save connection</button></form>`;\n    if (kind === \"request\") return top + KaiI18n.html`<form data-hub-form=\"request\" class=\"hub-panel\"><h3>${esc(item.name)}</h3><p>${esc(item.baseUrl)}</p><div class=\"hub-form-grid\">${field(\"Operation\", select(\"operationId\", item.operations.map(o => [o.id, o.name + \" · \" + o.method]), item.operations[0].id), true)}${field(\"Path variables (JSON)\", area(\"variables\", \"{}\", 5))}${field(\"Request body (writes only, JSON)\", area(\"body\", \"{}\", 5))}</div><p class=\"hub-help\" id=\"operation-help\">${esc(item.operations[0].path)}</p><button class=\"primary\">Run request</button><pre id=\"connection-result\" class=\"hub-result\" aria-live=\"polite\"></pre></form>`;\n    if (kind === \"source\") return top + KaiI18n.html`<form data-hub-form=\"source\" class=\"hub-panel\"><div class=\"hub-form-grid\">${field(\"Source name\", input(\"name\", \"\", \"KAI project issues\"), true)}${field(\"Connection\", select(\"connectionId\", state.connections.filter(c => c.enabled && c.allowSync).map(c => [c.id, c.name]), item.connectionId))}${field(\"GET operation\", select(\"operationId\", sourceOps(item.connectionId), item.operationId))}${field(\"Path variables (JSON)\", area(\"variables\", \"{}\"), true)}</div>${check(\"autoSync\", \"Sync every 20 minutes while KAI is open\", false)}<p class=\"hub-help\">Only connections with background reads enabled are listed.</p><button class=\"primary\">Add source</button></form>`;\n    return top + KaiI18n.html`<form data-hub-form=\"workflow\" class=\"hub-panel\"><div class=\"hub-form-grid\">${field(\"Workflow name\", input(\"name\", item.name), true)}${field(\"Purpose\", input(\"description\", item.description), true)}${field(\"Local reasoning model\", select(\"model\", [[\"\", \"Choose installed model\"], ...state.models.map(m => [m.alias, m.label || m.alias])], item.model))}${field(\"Run schedule\", select(\"schedule\", [\"manual\", \"hourly\", \"every6h\", \"daily\", \"weekly\"], item.schedule?.kind || \"manual\"))}${field(\"Hour (daily / weekly, local time)\", '<input type=\"number\" min=\"0\" max=\"23\" name=\"hour\" value=\"' + (item.schedule?.hour ?? 9) + '\"/>')}${field(\"Day (weekly)\", select(\"day\", [[\"0\", \"Sunday\"], [\"1\", \"Monday\"], [\"2\", \"Tuesday\"], [\"3\", \"Wednesday\"], [\"4\", \"Thursday\"], [\"5\", \"Friday\"], [\"6\", \"Saturday\"]], String(item.schedule?.day ?? 1)))}</div>${check(\"enabled\", \"Enable the saved schedule\", item.enabled)}<details class=\"hub-advanced\"><summary>Describe a workflow to KAI</summary>${field(\"What should the routine do?\", area(\"describe\", \"\", 3), true)}${button(\"Draft steps with KAI\", \"draftWorkflow\")}<p class=\"hub-help\">Uses the selected local model. Review the generated steps below before saving.</p></details><p class=\"hub-help\">Steps run top to bottom. {{input}} is the run input; {{previous}} is the last step's output. A condition continues only when the previous output contains its text.</p><div class=\"hub-flow-editor\">${item.steps.map(stepHTML).join(\"\")}</div><div class=\"hub-toolbar\">${button(\"Add step\", \"addStep\")}<button class=\"primary\">Save workflow</button></div></form>`;\n  }\n  function sourceOps(key) { const c = state.connections.find(c => c.id === key) || state.connections.find(c => c.enabled && c.allowSync); return (c?.operations || []).filter(o => o.method === \"GET\").map(o => [o.id, o.name]); }\n  function stepHTML(s, i) {\n    return KaiI18n.html`<div class=\"hub-step\" data-step=\"${i}\"><div class=\"hub-step-number\">${i + 1}</div><div class=\"hub-step-main\"><div class=\"hub-form-grid\">${field(\"Step type\", select(\"type\", [[\"brain_search\", \"Search Brain\"], [\"prompt\", \"Ask local model\"], [\"connection\", \"Call a connection\"], [\"condition\", \"Continue if text matches\"], [\"approval\", \"Wait for approval\"], [\"remember\", \"Save to Brain\"], [\"output\", \"Result\"]], s.type))}${field(\"Label\", input(\"label\", s.label))}${field(s.type === \"condition\" ? \"Text to match\" : \"Instructions or text\", area(\"text\", s.text, 3), true)}</div>${s.type === \"connection\" ? KaiI18n.html`<div class=\"hub-form-grid\">${field(\"Connection\", select(\"connectionId\", [[\"\", \"Choose connection\"], ...state.connections.map(c => [c.id, c.name])], s.connectionId))}${field(\"Operation ID\", input(\"operationId\", s.operationId))}${field(\"Variables (JSON)\", area(\"variables\", JSON.stringify(s.variables || {}, null, 2), 4))}${field(\"Body (JSON)\", area(\"body\", JSON.stringify(s.body || {}, null, 2), 4))}</div>` : \"\"}<div class=\"hub-actions\">${button(\"Move up\", \"stepUp\", String(i))}${button(\"Move down\", \"stepDown\", String(i))}${button(\"Remove step\", \"removeStep\", String(i))}</div></div></div>`;\n  }\n  function collectWorkflow() {\n    const f = host().querySelector(\"form\");\n    return { ...editor.item, name: value(f, \"name\"), description: value(f, \"description\"), model: value(f, \"model\"), enabled: bool(f, \"enabled\"), schedule: { kind: value(f, \"schedule\"), hour: Number(value(f, \"hour\")), day: Number(value(f, \"day\")) },\n      steps: [...f.querySelectorAll(\"[data-step]\")].map(el => { const v = name => el.querySelector(`[name=\"${name}\"]`)?.value || \"\"; const s = { type: v(\"type\"), label: v(\"label\"), text: v(\"text\") }; if (s.type === \"connection\") { s.connectionId = v(\"connectionId\"); s.operationId = v(\"operationId\"); try { s.variables = JSON.parse(v(\"variables\") || \"{}\"); s.body = JSON.parse(v(\"body\") || \"{}\"); } catch { throw new Error(\"Connection step variables and body must be valid JSON.\"); } } return s; }) };\n  }\n  function template(key) {\n    const search = { type: \"brain_search\", label: \"Gather context\", text: \"{{input}}\" }, ask = { type: \"prompt\", label: \"Write a briefing\", text: \"Summarize these notes and identify useful next steps. Cite note titles.\\n\\n{{previous}}\" }, result = { type: \"output\", label: \"Keep the result\", text: \"{{previous}}\" };\n    return { name: { briefing: \"Project briefing\", review: \"Weekly goal review\", api: \"API digest\" }[key] || \"New workflow\", model: state.models[0]?.alias || \"\", schedule: { kind: \"manual\", hour: 9, day: 1 }, enabled: false, steps: key === \"review\" ? [search, ask, { type: \"remember\", label: \"Reviewed next steps\", text: \"{{previous}}\" }] : key === \"api\" ? [{ type: \"connection\", label: \"Read a saved API\", connectionId: state.connections[0]?.id || \"\", operationId: state.connections[0]?.operations[0]?.id || \"\", variables: {}, body: {} }, ask, result] : [search, ask, result] };\n  }\n  async function render(view = current) {\n    clearTimeout(timer); if (view !== current) editor = null; current = view;\n    try { if (bridge) await refresh(); draw(); } catch (e) { shell(); note(e.message, true); }\n    poll();\n  }\n  function poll() {\n    clearTimeout(timer); if (!bridge || editor || host()?.hidden) return;\n    timer = setTimeout(async () => { if (host()?.hidden || editor || busy) return poll(); try { const before = JSON.stringify([state.runs, state.brain, state.syncing]); await refresh(); if (before !== JSON.stringify([state.runs, state.brain, state.syncing]) && (false || current === \"brain\" && [\"overview\", \"orchestration\", \"sync\"].includes(tab.brain)) && !host().querySelector(\"form:focus-within, details[open]:focus-within\")) draw(); } catch { /* show next explicit operation error */ } poll(); }, 2500);\n  }\n  async function action(name, key) {\n    if (name === \"tab\") { editor = null; tab[current] = key; draw(); poll(); return; }\n    if (name === \"closeEditor\") { editor = null; draw(); poll(); return; }\n    if (name === \"legacyTools\" || name === \"providerSettings\" || name === \"modelLibrary\" || name === \"legacyTasks\") { activateView({ legacyTools: \"tools\", providerSettings: \"settings\", modelLibrary: \"models\", legacyTasks: \"tasks\" }[name]); return; }\n    const editing = { run: [\"run\", state.workflows.find(w => w.id === key)], newNote: [\"note\", {}], editNote: [\"note\", state.notes.find(n => n.id === key)], newGoal: [\"goal\", {}], editGoal: [\"goal\", state.goals.find(n => n.id === key)], newWorkflow: [\"workflow\", template(\"briefing\")], templateWorkflow: [\"workflow\", template(key)], editWorkflow: [\"workflow\", state.workflows.find(w => w.id === key)], newConnection: [\"connection\", state.templates.at(-1)], connectionTemplate: [\"connection\", state.templates.find(t => t.id === key)], editConnection: [\"connection\", state.connections.find(c => c.id === key)], useConnection: [\"request\", state.connections.find(c => c.id === key)], newSource: [\"source\", { connectionId: state.connections.find(c => c.enabled && c.allowSync)?.id }] };\n    if (editing[name]) { const [kind, item] = editing[name]; editor = { kind, item: JSON.parse(JSON.stringify(item || {})) }; if ([\"newConnection\", \"connectionTemplate\"].includes(name)) delete editor.item.id; draw(); return; }\n    if ([\"addStep\", \"removeStep\", \"stepUp\", \"stepDown\"].includes(name)) { editor.item = collectWorkflow(); const i = Number(key), steps = editor.item.steps; if (name === \"addStep\") steps.push({ type: \"prompt\", label: \"New step\", text: \"{{previous}}\" }); if (name === \"removeStep\") steps.splice(i, 1); const to = name === \"stepUp\" ? i - 1 : name === \"stepDown\" ? i + 1 : -1; if (to >= 0 && to < steps.length) [steps[to], steps[i]] = [steps[i], steps[to]]; draw(); return; }\n    if (name === \"draftWorkflow\") {\n      const form = host().querySelector(\"form\"), request = value(form, \"describe\").trim(); if (!request) throw new Error(\"Describe the routine first.\");\n      editor.item = collectWorkflow(); if (!editor.item.model) throw new Error(\"Choose an installed local model first.\"); note(\"KAI is drafting the steps…\");\n      const response = await KaiProviders.chatFetch(\"/core/chat/completions\", { method: \"POST\", headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ model: editor.item.model, stream: false, max_tokens: 1500, messages: [{ role: \"system\", content: 'Draft a KAI workflow. Return ONLY JSON {\"steps\":[{\"type\":\"brain_search|prompt|approval|remember|output\",\"label\":\"short label\",\"text\":\"instructions\"}]}. At most 8 steps. Use {{input}} for run input and {{previous}} for last output. No tools, code, or API calls. Add approval before remembering. Do not claim it has run.' }, { role: \"user\", content: request.slice(0, 4000) }] }) });\n      if (!response.ok) throw new Error(\"The local model could not draft the workflow.\"); const reply = await response.json(); const raw = reply.choices?.[0]?.message?.content || \"\"; const parsed = JSON.parse(raw.replace(/^\\s*```(?:json)?\\s*/, \"\").replace(/\\s*```\\s*$/, \"\"));\n      if (!Array.isArray(parsed.steps) || !parsed.steps.length || parsed.steps.length > 8 || parsed.steps.some(s => ![\"brain_search\", \"prompt\", \"approval\", \"remember\", \"output\"].includes(s.type))) throw new Error(\"The model did not return a valid draft. Try a clearer description or add steps manually.\");\n      editor.item.steps = parsed.steps; draw(); note(\"Draft ready. Review every step and save when it matches your intent.\"); return;\n    }\n    const deleting = { deleteNote: [\"notes\", \"note\"], deleteGoal: [\"goals\", \"goal\"], deleteSource: [\"sources\", \"source and its indexed content\"], deleteConnection: [\"\", \"connection\"], deleteWorkflow: [\"\", \"workflow and run history\"] };\n    if (deleting[name]) { if (!await window.kai.dialogs.confirm(\"Remove this \" + deleting[name][1] + \"?\")) return; await manage(name === \"deleteConnection\" ? \"removeConnection\" : name === \"deleteWorkflow\" ? \"removeWorkflow\" : \"remove\", { id: key, kind: deleting[name][0] }); }\n    else if (name === \"completeGoal\") await manage(\"goal\", { ...state.goals.find(g => g.id === key), status: \"done\" });\n    else if (name === \"sourceToggle\") await manage(\"sourceToggle\", { id: key, enabled: !state.sources.find(s => s.id === key).autoSync });\n    else await manage(name, { id: key });\n    await refresh(); draw(); note(name === \"sync\" ? \"Source synced.\" : name === \"run\" ? \"Workflow started.\" : \"Done.\"); poll();\n  }\n  document.addEventListener(\"click\", async e => {\n    const b = e.target.closest(\"[data-hub-action]\"); if (!b || !b.closest(\".companion-hub\") || busy) return;\n    busy = true; b.disabled = true;\n    try { await action(b.dataset.hubAction, b.dataset.id); } catch (error) { note(error.message, true); }\n    finally { busy = false; b.disabled = false; }\n  });\n  document.addEventListener(\"change\", async e => {\n    if (!e.target.closest(\".companion-hub\")) return;\n    try {\n      if (e.target.id === \"brain-recall\") { await manage(\"recall\", { enabled: e.target.checked }); note(e.target.checked ? \"Brain recall enabled.\" : \"Automatic Brain recall paused.\"); }\n      if (editor?.kind === \"workflow\" && e.target.name === \"type\") { editor.item = collectWorkflow(); draw(); }\n      if (editor?.kind === \"source\" && e.target.name === \"connectionId\") { const s = host().querySelector('[name=\"operationId\"]'); s.innerHTML = sourceOps(e.target.value).map(([key, label]) => KaiI18n.html`<option value=\"${esc(key)}\">${esc(label)}</option>`).join(\"\"); }\n      if (editor?.kind === \"request\" && e.target.name === \"operationId\") document.getElementById(\"operation-help\").textContent = editor.item.operations.find(o => o.id === e.target.value)?.path || \"\";\n    } catch (error) { note(error.message, true); }\n  });\n  document.addEventListener(\"submit\", async e => {\n    const form = e.target.closest(\"[data-hub-form]\"); if (!form) return; e.preventDefault(); if (busy) return; busy = true;\n    const submit = form.querySelector('button:not([type=\"button\"])'); if (submit) submit.disabled = true;\n    try {\n      const kind = form.dataset.hubForm, old = editor.item;\n      let body;\n      if (kind === \"run\") body = { id: old.id, input: value(form, \"input\") };\n      if (kind === \"note\") body = { id: old.id, title: value(form, \"title\"), text: value(form, \"text\"), category: value(form, \"category\"), tags: value(form, \"tags\"), pinned: bool(form, \"pinned\") };\n      if (kind === \"goal\") body = { id: old.id, title: value(form, \"title\"), detail: value(form, \"detail\"), status: value(form, \"status\"), priority: value(form, \"priority\") };\n      if (kind === \"workflow\") body = collectWorkflow();\n      if (kind === \"connection\") { body = { id: old.id, name: value(form, \"name\"), baseUrl: value(form, \"baseUrl\"), auth: value(form, \"auth\"), headerName: value(form, \"headerName\"), secret: value(form, \"secret\"), headers: json(form, \"headers\"), operations: json(form, \"operations\", []), enabled: bool(form, \"enabled\"), allowAgent: bool(form, \"allowAgent\"), allowSync: bool(form, \"allowSync\") }; form.elements.secret.value = \"\"; }\n      if (kind === \"source\") body = { name: value(form, \"name\"), connectionId: value(form, \"connectionId\"), operationId: value(form, \"operationId\"), variables: json(form, \"variables\"), autoSync: bool(form, \"autoSync\") };\n      if (kind === \"request\") body = { connectionId: old.id, operationId: value(form, \"operationId\"), variables: json(form, \"variables\"), body: json(form, \"body\") };\n      note(kind === \"request\" ? \"Running the request…\" : \"Saving…\");\n      const result = await manage(kind, body); if (body?.secret) body.secret = \"\";\n      if (kind === \"request\") { document.getElementById(\"connection-result\").textContent = String(result); note(\"Request completed.\"); }\n      else { editor = null; if (kind === \"note\") tab.brain = \"notes\"; if (kind === \"run\") tab.workflows = \"runs\"; await refresh(); draw(); note(kind === \"run\" ? \"Workflow started.\" : \"Saved.\"); poll(); }\n    } catch (error) { note(error.message, true); }\n    finally { busy = false; if (submit) submit.disabled = false; }\n  });\n  window.KaiCompanionHub = { render };\n})();\n","connection-catalog.js":"\"use strict\";\n// Composio catalog metadata: MIT, Sampark Inc. See docs/licenses/COMPOSIO-CATALOG.txt.\nwindow.KaiConnectionCatalog = {\"version\":1,\"updated\":\"2026-09-09\",\"source\":\"https://github.com/ComposioHQ/composio/blob/next/docs/public/data/toolkits.json\",\"categories\":[{\"id\":\"communication\",\"name\":\"Chat & email\"},{\"id\":\"knowledge\",\"name\":\"Files & knowledge\"},{\"id\":\"development\",\"name\":\"Developer tools\"},{\"id\":\"automation\",\"name\":\"AI & automation\"},{\"id\":\"social\",\"name\":\"Marketing & social\"},{\"id\":\"business\",\"name\":\"Business\"},{\"id\":\"lifestyle\",\"name\":\"Everyday life\"},{\"id\":\"productivity\",\"name\":\"Productivity & design\"}],\"items\":[{\"slug\":\"0codekit\",\"name\":\"0CodeKit\",\"description\":\"0CodeKit provides utility APIs for AI, document and image processing, data conversion, validation, generation, storage, and automation workflows.\",\"category\":\"development\",\"categories\":[\"Developer tools\"],\"originalCategory\":\"developer tools\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":8,\"triggerCount\":0},{\"slug\":\"_1password\",\"name\":\"1password\",\"description\":\"Password manager and digital vault for secure credential storage and team collaboration\",\"category\":\"development\",\"categories\":[\"Developer tools\"],\"originalCategory\":\"security & identity tools\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":6,\"triggerCount\":0},{\"slug\":\"_21risk\",\"name\":\"21risk\",\"description\":\"21RISK is a web application that simplifies working with checklists, audits, and actions, facilitating compliance and risk management processes.\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"business intelligence\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":8,\"triggerCount\":0},{\"slug\":\"_2chat\",\"name\":\"2chat\",\"description\":\"2Chat provides a programmable API for integrating WhatsApp and other text channels, enabling developers to send and receive messages, manage groups, and automate workflows.\",\"category\":\"communication\",\"categories\":[\"Chat & email\"],\"originalCategory\":\"communication\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":5,\"triggerCount\":0},{\"slug\":\"44api\",\"name\":\"44API\",\"description\":\"44API validates VAT and tax identifiers, returns available company details, and manages account IP whitelists.\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"taxes\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":4,\"triggerCount\":0},{\"slug\":\"7shifts\",\"name\":\"7shifts\",\"description\":\"7shifts is a restaurant team management platform for employee scheduling, time clocking, payroll, communication, and operational workflows.\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"human resources\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":10,\"triggerCount\":0},{\"slug\":\"ably\",\"name\":\"Ably\",\"description\":\"Ably is a real-time messaging platform helping developers build live features, including chat and data synchronization, with global scalability and robust reliability for modern applications\",\"category\":\"development\",\"categories\":[\"Developer tools\"],\"originalCategory\":\"developer tools\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":25,\"triggerCount\":0},{\"slug\":\"abstract\",\"name\":\"Abstract\",\"description\":\"Abstract API provides a suite of APIs for developers to automate various tasks, including data validation, enrichment, and more.\",\"category\":\"development\",\"categories\":[\"Developer tools\"],\"originalCategory\":\"developer tools\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":3,\"triggerCount\":0},{\"slug\":\"abuselpdb\",\"name\":\"AbuseIPDB\",\"description\":\"AbuseIPDB is a project dedicated to helping make the internet safer by providing a central repository for reporting and checking IP addresses associated with malicious activities.\",\"category\":\"development\",\"categories\":[\"Developer tools\"],\"originalCategory\":\"security & identity tools\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":6,\"triggerCount\":0},{\"slug\":\"abyssale\",\"name\":\"Abyssale\",\"description\":\"Abyssale is a creative automation platform that enables users to generate images, videos, GIFs, PDFs, and HTML5 content programmatically, streamlining visual content production.\",\"category\":\"productivity\",\"categories\":[\"Productivity & design\"],\"originalCategory\":\"images & design\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":4,\"triggerCount\":0},{\"slug\":\"accredible_certificates\",\"name\":\"Accredible certificates\",\"description\":\"Accredible Certificates is a platform that enables organizations to create, manage, and distribute digital certificates, open badges, and blockchain credentials.\",\"category\":\"lifestyle\",\"categories\":[\"Everyday life\"],\"originalCategory\":\"education\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":36,\"triggerCount\":0},{\"slug\":\"acculynx\",\"name\":\"Acculynx\",\"description\":\"AccuLynx is the leading, all-in-one roofing software designed to streamline every aspect of a roofing business.\",\"category\":\"business\",\"categories\":[\"Business\"],\"originalCategory\":\"crm\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":8,\"triggerCount\":0},{\"slug\":\"active_campaign\",\"name\":\"ActiveCampaign\",\"description\":\"ActiveCampaign is a marketing automation and CRM platform enabling businesses to manage email campaigns, sales pipelines, and customer segmentation to boost engagement and drive growth\",\"category\":\"automation\",\"categories\":[\"AI & automation\"],\"originalCategory\":\"marketing automation\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":298,\"triggerCount\":0},{\"slug\":\"active_merge\",\"name\":\"ActiveMerge\",\"description\":\"ActiveMerge automates document and image generation, document merging, e-signatures, file storage, and template-based workflows.\",\"category\":\"knowledge\",\"categories\":[\"Files & knowledge\"],\"originalCategory\":\"documents\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":13,\"triggerCount\":0},{\"slug\":\"active_trail\",\"name\":\"ActiveTrail\",\"description\":\"ActiveTrail is the world's friendliest email marketing platform, newsletter software and marketing automation software.\",\"category\":\"communication\",\"categories\":[\"Chat & email\"],\"originalCategory\":\"email newsletters\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":159,\"triggerCount\":0},{\"slug\":\"adafruit_io\",\"name\":\"Adafruit IO\",\"description\":\"Adafruit IO is a cloud platform for storing, visualizing, and acting on data from connected devices and Internet of Things projects.\",\"category\":\"lifestyle\",\"categories\":[\"Everyday life\"],\"originalCategory\":\"internet of things\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":21,\"triggerCount\":0},{\"slug\":\"addressfinder\",\"name\":\"Addressfinder\",\"description\":\"A reliably smart, reliably accurate data quality platform for address, email, and phone verification\",\"category\":\"development\",\"categories\":[\"Developer tools\"],\"originalCategory\":\"developer tools\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":17,\"triggerCount\":0},{\"slug\":\"addresszen\",\"name\":\"Addresszen\",\"description\":\"AddressZen provides address autocomplete and verification services, offering real-time address suggestions and validation to ensure accurate and deliverable addresses.\",\"category\":\"development\",\"categories\":[\"Developer tools\"],\"originalCategory\":\"developer tools\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":2,\"triggerCount\":0},{\"slug\":\"adobe_marketing_agent_mcp\",\"name\":\"Adobe Marketing Agent MCP\",\"description\":\"Adobe Marketing Agent MCP provides authorized Adobe marketing context, preferences, and agent capabilities through Adobe's hosted MCP service.\",\"category\":\"development\",\"categories\":[\"Developer tools\"],\"originalCategory\":\"model context protocol\",\"authSchemes\":[\"DCR_OAUTH\"],\"managedSchemes\":[],\"toolCount\":12,\"triggerCount\":0},{\"slug\":\"adrapid\",\"name\":\"Adrapid\",\"description\":\"Adrapid is a tool designed for efficient creation of digital marketing visuals, including banners, images, videos, and HTML5 content, utilizing reusable templates and offering automation through a REST API.\",\"category\":\"productivity\",\"categories\":[\"Productivity & design\"],\"originalCategory\":\"images & design\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":3,\"triggerCount\":0},{\"slug\":\"adtraction\",\"name\":\"Adtraction\",\"description\":\"Adtraction is an affiliate marketing platform for managing partner programs, tracking links, transactions, commissions, statistics, and payments.\",\"category\":\"social\",\"categories\":[\"Marketing & social\"],\"originalCategory\":\"marketing\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":22,\"triggerCount\":0},{\"slug\":\"adyntel\",\"name\":\"Adyntel\",\"description\":\"Adyntel provides an API to retrieve LinkedIn ads for a given company using the company's domain or LinkedIn Page ID.\",\"category\":\"social\",\"categories\":[\"Marketing & social\"],\"originalCategory\":\"ads & conversion\",\"authSchemes\":[\"API_KEY\"],\"managedSchemes\":[],\"toolCount\":8,\