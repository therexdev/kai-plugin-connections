:flex;flex-direction:column;height:680px;min-height:0;overflow:hidden}\n.product-v2 .product-reward-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:10px 0}\n.product-v2 .product-reward-summary section{padding:12px;border:1px solid var(--border);border-radius:12px;background:var(--bg);min-width:0}\n.product-v2 .product-reward-summary h3{margin:0 0 9px;font-size:12px;font-weight:600;color:var(--text-dim)}\n.product-v2 .product-reward-summary strong{display:block;font-size:20px;letter-spacing:-.4px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}\n.product-v2 .product-reward-summary-label{display:block;margin-top:5px;font-size:10px;color:var(--text-dim)}\n.product-v2 .product-reward-summary p{margin:10px 0 0;font-size:10px;line-height:1.6;color:var(--text-dim);overflow-wrap:anywhere}\n.product-v2 #product-reward-schedule{font-size:11px;line-height:1.6;margin:0 0 10px}\n.product-v2 .product-rewards>.product-row{align-items:center;gap:12px}\n.product-v2 .product-rewards h2{font-size:18px;letter-spacing:-.3px}\n.product-v2 .product-rewards .product-reward-intro{margin:10px 0 5px;font-size:12px}\n.product-v2 .product-rewards #product-reward-status{min-height:32px;margin:0 0 12px;line-height:1.6}\n.product-v2 .product-reward-auto{display:inline-flex;align-items:center;gap:6px;flex:none;font-size:10px;color:var(--text-dim);white-space:nowrap}\n.product-v2 .product-reward-auto i{height:6px;width:6px;border-radius:50%;background:#94a3b8}\n.product-v2 .product-reward-auto[data-state=\"ready\"] i{background:#168469}\n.product-v2 .product-reward-auto[data-state=\"updating\"] i{background:#155eef}\n.product-v2 .product-reward-auto[data-state=\"stale\"] i{background:#b37a18}\n.product-v2 .product-reward-feed{list-style:none;padding:0 10px 0 0;margin:0;min-height:0;flex:1;overflow:auto;overscroll-behavior:contain;scrollbar-gutter:stable;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}\n.product-v2 .product-reward-feed:focus-visible{outline:2px solid var(--violet);outline-offset:3px;border-radius:5px}\n.product-v2 .product-reward-item{padding:18px 0;border-bottom:1px solid var(--border)}\n.product-v2 .product-reward-item:last-child{border-bottom:0}\n.product-v2 .product-reward-main{display:flex;justify-content:space-between;align-items:flex-start;gap:14px}\n.product-v2 .product-reward-day{display:block;font-size:12px;font-weight:600;color:var(--text)}\n.product-v2 .product-reward-period{display:block;font-size:10px;color:var(--text-dim);margin-top:4px}\n.product-v2 .product-reward-amount{font-size:16px;font-weight:650;letter-spacing:-.25px;text-align:right;overflow-wrap:anywhere;min-width:0;color:var(--text)}\n.product-v2 .product-reward-amount small{font-size:10px;color:var(--text-dim);font-weight:550;letter-spacing:0}\n.product-v2 .product-reward-item[data-state=\"paid\"] .product-reward-amount,.product-v2 .product-reward-item[data-state=\"paid_elsewhere\"] .product-reward-amount{color:#168469}\n.product-v2 .product-reward-meta{display:flex;align-items:center;gap:10px;justify-content:space-between;margin-top:12px;flex-wrap:wrap}\n.product-v2 .product-reward-state{font-size:10px;line-height:1.4;font-weight:600;padding:4px 8px;border-radius:6px;background:#edf4ff;color:#155eef;white-space:nowrap}\n.product-v2 .product-reward-state[data-tone=\"paid\"]{background:#e2f6ed;color:#126846}\n.product-v2 .product-reward-state[data-tone=\"attention\"]{background:#fff0dc;color:#865716}\n.product-v2 .product-reward-breakdown{color:var(--text-dim);font-size:9px;line-height:1.5;overflow-wrap:anywhere}\n.product-v2 .product-reward-empty{min-height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:10px;padding:28px 18px;box-sizing:border-box;color:var(--text-dim)}\n.product-v2 .product-reward-empty strong{font-size:14px;font-weight:600;color:var(--text)}\n.product-v2 .product-reward-empty>span:not(.product-reward-empty-mark){font-size:12p