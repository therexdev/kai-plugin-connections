px}.welcome-copy h2{font-size:36px}.welcome-eyebrow{position:absolute;top:73px;left:0;max-width:100px;line-height:1.8}.welcome-prompts{grid-template-columns:1fr}.welcome-prompts button{min-height:69px;padding:14px 18px 14px 59px}.prompt-symbol{position:absolute;left:15px;top:18px}.welcome-prompts small{font-size:10px}.welcome-footnote{font-size:9px;margin-top:16px}.composer-options{gap:1px;padding:8px 4px}#composer{margin:3px 14px 16px}#composer select{font-size:9px;padding:6px 2px}.docs-side{width:140px}.docs-main{padding:24px 18px}.kn-shell{grid-template-columns:124px minmax(0,1fr)}#kn-rail{padding:12px 6px}.kc-item{font-size:11px}.provider-card{padding:18px}.provider-heading{flex-wrap:wrap;gap:0}.provider-heading h3{margin-bottom:6px}.model-offer{flex-wrap:wrap;padding:17px}.cmp-controls{gap:8px}#cmp-panes{grid-template-columns:1fr}.api-card>h1{font-size:25px}}\n@media(max-height:820px){#sidebar{padding-top:17px;gap:8px}.brand{padding-bottom:5px}.nav-item{min-height:34px;padding-top:7px;padding-bottom:7px}.nav-group-label{padding-top:10px}.workspace-header{min-height:72px;padding-top:13px;padding-bottom:13px}.welcome-character{height:222px;width:170px}.welcome-hero{grid-template-columns:minmax(0,1fr) 170px;padding-bottom:15px}.welcome-prompts button{min-height:115px;padding-top:14px;padding-bottom:14px}.prompt-symbol{margin-bottom:9px}.welcome-footnote{margin-top:13px}.welcome-copy h2{font-size:37px}.onboard-character{height:120px}.onboard-card{padding:24px}.chat-toolbar{padding-top:6px;min-height:28px}}\n@media(max-width:700px) and (max-height:820px){.welcome-hero{grid-template-columns:1fr}.welcome-character{width:95px;height:135px}.welcome-copy{padding-top:140px}.welcome-prompts button{min-height:69px}}\n\n/* Developer Tools: local form rules keep shared API styles from stretching\n   selects and checkboxes into full-width rows. Size against the workspace,\n   including when the desktop sidebar leaves less room than the viewport. */\n#view-devtools { container-type: inline-size; }\n#view-devtools .api-card { gap: 12px; }\n#view-devtools .subtabs { flex-wrap: wrap; gap: 4px; margin: 4px 0 6px; }\n#view-devtools .subtab { padding: 9px 14px; font-size: 13px; }\n#view-devtools .devtab, #dev-builder { display: flex; flex-direction: column; gap: 16px; min-width: 0; }\n#view-devtools .devtab > .hint { max-width: 78ch; }\n#view-devtools .form-row { margin: 0; gap: 10px; min-width: 0; }\n#view-devtools .dev-fields { display: grid; gap: 12px; align-items: end; }\n#view-devtools .dev-team-fields { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); }\n#view-devtools .dev-limits { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n#view-devtools .dev-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; font-size: 12px; font-weight: 600; color: var(--text-dim); }\n#view-devtools .dev-field > input, #view-devtools .dev-field > select,\n#view-devtools #pg-input {\n  flex: none; width: 100%; min-width: 0; min-height: 38px; padding: 8px 10px;\n  border: 1px solid var(--border); border-radius: 9px;\n  background: var(--bg-raised); color: var(--text); font: inherit; font-size: 13px; font-weight: 400;\n}\n#view-devtools .dev-field > select { padding-right: 28px; text-overflow: ellipsis; }\n#view-devtools input:focus-visible, #view-devtools select:focus-visible,\n#view-devtools textarea:focus-visible, #view-devtools summary:focus-visible { outline: 2px solid var(--violet); outline-offset: 2px; }\n#view-devtools button.small { min-height: 36px; padding: 8px 12px; font-size: 12px; }\n#view-devtools .check { white-space: normal; min-width: 0; gap: 8px; line-height: 1.5; }\n#view-devtools input[type=\"checkbox\"] { flex: 0 0 16px; width: 16px; min-width: 16px; height: 16px; padding: 0; margin: 0; }\n#ag-list { display: grid; gap: 12px; }\n#view-devtools .agent-card { display: flex; flex-direction: column; gap: 12px; margin: 0; padding: 16px; min-width: 0; }\n#view-devtools .dev-agent-head { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: end; }\n#view-devtools .dev-agent-head > .check, #view-devtools .ag-remove { min-height: 38px; }\n#view-devtools .ag-remove { padding: 8px 0 8px 8px; font-size: 12px; }\n#view-devtools textarea { display: block; min-width: 0; max-width: 100%; margin: 0; font: 12px/1.65 ui-monospace, \"Cascadia Mono\", Consolas, monospace; }\n#view-devtools .ag-prompt { min-height: 72px; font: 13px/1.6 system-ui, sans-serif; color: var(--text); }\n#view-devtools .dev-tool-picker { width: 100%; min-width: 0; border-top: 1px solid var(--border); padding-top: 10px; }\n#view-devtools .dev-tool-picker > summary { cursor: pointer; font-size: 12px; font-weight: 600; color: var(--text-dim); padding: 3px 0; }\n#view-devtools .dev-tool-choices { margin-top: 12px; }\n#view-devtools .tool-group { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 6px 16px; align-items: start; }\n#view-devtools .tool-group-head { grid-column: 1 / -1; min-width: 0; flex-wrap: wrap; }\n#view-devtools .tool-group-name, #view-devtools .check > span { overflow-wrap: anywhere; }\n#view-devtools .tool-group .check { align-items: start; padding: 3px 0; }\n#view-devtools .tool-group input { margin-top: 2px; }\n#view-devtools .dev-editor { display: flex; flex-direction: column; gap: 10px; padding-top: 16px; border-top: 1px solid var(--border); min-width: 0; }\n#view-devtools .dev-section-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; font-size: 13px; font-weight: 600; }\n#view-devtools .dev-saved-team { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 10px; padding-top: 16px; border-top: 1px solid var(--border); }\n#view-devtools .dev-stages { border: 0; padding: 0; min-width: 0; }\n#view-devtools .dev-stages legend { font-size: 12px; font-weight: 600; color: var(--text-dim); margin-bottom: 8px; }\n#view-devtools #devb-stages { gap: 10px 20px; }\n#view-devtools #pg-input { flex: 1 1 180px; width: auto; }\n#view-devtools #pg-convo { margin: 0; }\n#view-devtools #pg-convo:empty { display: none; }\n#view-devtools .snippet { max-width: 100%; white-space: pre-wrap; overflow-wrap: anywhere; }\n#view-devtools .pg-msg, #view-devtools .pg-tool, #view-devtools .meta { overflow-wrap: anywhere; }\n@container (max-width: 580px) {\n  #view-devtools .dev-team-fields { grid-template-columns: minmax(0, 1fr); }\n  #view-devtools .dev-limits { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  #view-devtools .dev-limits > :last-child { grid-column: 1 / -1; }\n}\n@container (max-width: 380px) {\n  #view-devtools .subtabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  #view-devtools .subtab { padding: 8px; }\n  #view-devtools .dev-agent-head { grid-template-columns: minmax(0, 1fr) auto; }\n  #view-devtools .dev-agent-head > .dev-field { grid-column: 1 / -1; }\n  #view-devtools .dev-limits, #view-devtools .dev-saved-team { grid-template-columns: minmax(0, 1fr); }\n  #view-devtools .agent-card { padding: 12px; }\n}\n\n/* KAI companion workspaces */\n.companion-hub{max-width:1160px;margin:0 auto;padding:30px 32px 64px;box-sizing:border-box;color:var(--text,#eee)}\n.companion-hub *{box-sizing:border-box}.companion-hub [hidden]{display:none!important}.hub-header{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;margin-bottom:14px}.hub-eyebrow{font-size:10px;font-weight:700;letter-spacing:.16em;color:var(--violet);margin-bottom:9px}.hub-header h1{font-size:30px;letter-spacing:-.035em;line-height:1.15;margin:0 0 10px}.hub-header p,.hub-card p,.hub-template p{color:var(--text-dim);line-height:1.6;margin:7px 0 14px;font-size:13px}.hub-badge{display:inline-flex;align-items:center;border:1px solid var(--border,#333);border-radius:20px;padding:4px 9px;font-size:10px;line-height:1.4;white-space:nowrap;color:var(--text-dim)}.hub-tabs{display:flex;gap:4px;border-bottom:1px solid var(--border,#333);padding-bottom:8px;margin-bottom:22px;overflow:auto}.companion-hub button{font-size:12px;line-height:1.3;min-height:34px;border-radius:8px;padding:8px 12px;white-space:normal}.hub-tabs button{border:0;background:transparent;color:var(--text-dim);padding:10px 14px;white-space:nowrap}.hub-tabs button.active{background:var(--bg-raised);color:var(--text,#eee);box-shadow:inset 0 -2px var(--violet)}.hub-notice:empty{display:none}.hub-notice{margin:0 0 16px;padding:11px 13px;background:var(--bg-raised);border-radius:8px;font-size:13px;overflow-wrap:anywhere}.hub-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:0 0 18px}.hub-toolbar p{flex:1;color:var(--text-dim);font-size:13px;min-width:180px;margin:0}.hub-toolbar h2{font-size:18px;margin:0}.hub-search{flex:1;min-width:180px}.hub-search input{width:100%}.hub-metrics{display:flex;gap:24px;align-items:center;padding:18px 22px;border:1px solid var(--border,#333);border-radius:12px;margin-bottom:12px;flex-wrap:wrap}.hub-metrics>div{display:flex;align-items:baseline;gap:8px}.hub-metrics b{font-size:25px;letter-spacing:-.03em}.hub-metrics span{font-size:12px;color:var(--text-dim)}.hub-metrics .hub-check{margin:0 0 0 auto}.hub-help{font-size:12px;color:var(--text-dim);line-height:1.6;margin:10px 0 18px}.hub-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:14px}.hub-card,.hub-panel{padding:20px;background:var(--bg-raised);border:1px solid var(--border,#333);border-radius:12px;min-width:0}.hub-card h3{font-size:16px;line-height:1.4;margin:12px 0 8px;overflow-wrap:anywhere}.hub-card small{font-size:11px;color:var(--text-dim);overflow-wrap:anywhere}.hub-card-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.hub-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:16px}.hub-actions button{min-height:30px;padding:6px 10px;font-size:11px}.hub-tags{display:flex;gap:5px;flex-wrap:wrap}.hub-tags span{padding:2px 7px;font-size:10px;border-radius:5px;background:var(--bg,#15151a);color:var(--text-dim)}.hub-note-excerpt{white-space:pre-wrap;overflow-wrap:anywhere}.hub-tree-root{display:flex;align-items:center;gap:12px;padding:14px 0 24px}.hub-tree-root b,.hub-tree-root small{display:block}.hub-tree-root small{color:var(--text-dim);font-size:12px;margin-top:4px}.hub-orb{width:36px;height:36px;border-radius:50%;background:radial-gradient(circle at 30% 30%,#ddd0ff,#8c60b8 55%,#4d3968);box-shadow:0 0 30px #a58ae025}.hub-tree-branch{margin:0 0 16px 16px;padding-left:20px;border-left:1px solid var(--border,#333)}.hub-tree-branch>summary{cursor:pointer;font-size:14px;font-weight:600;padding:8px 0 14px}.hub-tree-branch>summary span{margin-left:10px;color:var(--text-dim);font-size:11px}.hub-empty{padding:38px 24px;border:1px dashed var(--border,#444);border-radius:12px;text-align:center;grid-column:1/-1}.hub-empty strong{font-size:17px}.hub-empty p{max-width:490px;margin:10px auto 0;font-size:13px;color:var(--text-dim);line-height:1.7}.hub-goal-board{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.hub-goal-board>section>h3{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-dim)}.hub-goal-board .hub-card{margin-bottom:12px}.hub-history>div{display:flex;gap:16px;align-items:center;padding:13px 0;border-bottom:1px solid var(--border,#333);font-size:12px}.hub-history strong{flex:1}.hub-history time{color:var(--text-dim)}.hub-section-title{font-size:16px;margin:30px 0 14px}.hub-template{text-align:left!important;background:transparent!important;border:1px solid var(--border,#333)!important;padding:18px!important;min-width:0}.hub-template:hover{border-color:var(--violet)!important}.hub-template strong{display:flex;justify-content:space-between;font-size:14px}.hub-template p{margin-bottom:0}.hub-mini-flow{display:flex;flex-wrap:wrap;gap:6px;margin-top:15px}.hub-mini-flow span{font-size:10px;border-left:2px solid var(--violet);padding:3px 6px;background:var(--bg,#15151a);border-radius:3px}.hub-run-list{display:grid;gap:12px}.hub-run>summary{display:flex;align-items:center;justify-content:space-between;gap:16px;cursor:pointer}.hub-run summary small{display:block;margin-top:5px}.hub-run-body{margin-top:18px}.hub-run-body>details{padding:10px 0;border-top:1px solid var(--border,#333);font-size:12px}.hub-run pre,.hub-result{white-space:pre-wrap;overflow-wrap:anywhere;max-height:420px;overflow:auto;font-size:12px;padding:12px;background:var(--bg,#15151a);border-radius:8px}.hub-badge.waiting{color:#e4b765}.hub-badge.completed{color:#80bea3}.hub-badge.failed,.hub-badge.interrupted{color:#eb9292}.hub-pending{border-left:2px solid #e4b765;padding-left:14px;margin-top:15px;font-size:12px}.hub-catalog{display:flex;gap:10px;flex-wrap:wrap}.hub-url{overflow-wrap:anywhere}.hub-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-bottom:16px}.hub-field{display:flex;flex-direction:column;gap:7px;min-width:0;font-size:12px}.hub-field>span{color:var(--text-dim);font-weight:500}.hub-full{grid-column:1/-1}.companion-hub input:not([type=checkbox]),.companion-hub select,.companion-hub textarea{width:100%;max-width:100%;min-width:0;padding:10px 11px;font-size:13px;line-height:1.5;border:1px solid var(--border,#383840);border-radius:7px;color:var(--text,#eee);background:var(--bg,#15151a)}.companion-hub textarea{resize:vertical;font-family:inherit}.companion-hub input[type=checkbox]{width:15px!important;min-width:15px!important;height:15px;margin:0;flex:none}.hub-check{display:flex;align-items:center;gap:9px;font-size:12px;line-height:1.5;margin:14px 0}.hub-checks{margin-bottom:18px}.hub-advanced{margin:20px 0;padding:14px;border:1px solid var(--border,#333);border-radius:8px}.hub-advanced>summary{cursor:pointer;font-size:13px;margin-bottom:12px}.hub-advanced textarea{font-family:ui-monospace,monospace;font-size:12px}.hub-advanced .hub-field{margin-top:12px}.hub-flow-editor{position:relative;display:grid;gap:18px;margin:24px 0}.hub-step{display:flex;gap:14px;position:relative}.hub-step:not(:last-child):before{content:\"\";position:absolute;left:15px;top:32px;bottom:-18px;border-left:1px solid var(--border,#444)}.hub-step-number{width:32px;height:32px;border:1px solid var(--violet);color:var(--violet);display:grid;place-items:center;border-radius:50%;font-size:12px;flex:none}.hub-step-main{min-width:0;flex:1;background:var(--bg,#15151a);border:1px solid var(--border,#333);border-radius:10px;padding:16px}.hub-step .hub-actions{margin-top:0}.hub-result:empty{display:none}.companion-hub .error{color:#e79797}\n@media(max-width:1000px){.companion-hub{padding:24px 20px}.hub-goal-board{grid-template-columns:1fr}.hub-header>.hub-badge{display:none}.hub-metrics{gap:18px;padding:15px}.hub-metrics .hub-check{margin-left:0}}\n@media(max-width:760px){.companion-hub{padding:20px 14px}.hub-header h1{font-size:26px}.hub-form-grid{grid-template-columns:1fr}.hub-full{grid-column:auto}.hub-tree-branch{margin-left:5px;padding-left:12px}.hub-card,.hub-panel{padding:16px}.hub-tabs button{padding:8px 10px}.hub-history>div{flex-wrap:wrap}.hub-step{gap:8px}.hub-step-main{padding:12px}.hub-metrics{gap:14px}.hub-metrics b{font-size:20px}.hub-metrics .hub-check{width:100%}}\n\n.companion-hub{overflow-y:auto;width:100%;display:block}.companion-hub .hub-header{flex-shrink:0}.companion-hub .error{color:var(--danger)}\n\n#view-brain, #view-workflows, #view-connections, #view-agents { overflow-y: auto; }\n\n/* App connections: catalog, account cards and guided connection drawer. */\n.cn-workspace{color:var(--text);min-width:0}.cn-workspace button{font-family:inherit;cursor:pointer}.cn-workspace .cn-button{background:#fff;border:1px solid #d5e2f3;color:#29456b;padding:9px 14px;min-height:36px;border-radius:9px;box-shadow:0 1px 2px #1b43700a;line-height:1.35}.cn-workspace .cn-button:hover{background:#f0f6ff;border-color:#a5c5fa}.cn-workspace .cn-button.cn-primary{color:#fff;background:#1765ef;border-color:#1765ef;box-shadow:0 3px 10px #1765ef1c}.cn-workspace button:disabled{opacity:.55;cursor:default}.cn-workspace button:focus-visible,.cn-workspace input:focus-visible,.cn-workspace select:focus-visible{outline:2px solid #1765ef;outline-offset:3px}.cn-notice{font-size:13px;line-height:1.6;border-radius:10px;padding:12px 15px;background:#eaf2ff;margin-bottom:16px;overflow-wrap:anywhere}.cn-notice:empty{display:none}.cn-notice.cn-error{background:#fff1ed;color:#a6412c}.cn-hero{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;background:linear-gradient(110deg,#e8f1ff,#f0f6ff 65%,#e8f7f9);padding:28px;border:1px solid #dce8f9;border-radius:18px;margin-bottom:24px}.cn-kicker{font-size:9px;letter-spacing:.16em;font-weight:750;color:#1765ef}.cn-hero h2{font-size:25px;letter-spacing:-.03em;line-height:1.2;margin:12px 0}.cn-hero p{color:#617590;font-size:13px;line-height:1.7;max-width:500px;margin:0}.cn-route{display:flex;align-items:center;gap:7px;flex:none;font-size:11px;background:#ffffffbd;padding:5px 5px 5px 11px;border:1px solid #dce8f9;border-radius:25px;white-space:nowrap}.cn-route .cn-button{font-size:10px;padding:5px 8px;min-height:26px;border:0;background:transparent;box-shadow:none}.cn-route-dot{width:6px;height:6px;border-radius:50%;background:#4c83eb}.cn-searchbar{display:flex;align-items:center;gap:12px;margin-bottom:14px}.cn-searchbar>span{font-size:27px;color:#647d9c}.cn-searchbar input{flex:1!important;font-size:14px!important;min-height:46px;background:#fff!important}.cn-categories{display:flex;gap:6px;overflow-x:auto;padding:5px 0 12px;scrollbar-width:thin}.cn-workspace .cn-category{white-space:nowrap;flex:none;border:0;background:transparent;color:#647d9c;padding:7px 12px;min-height:30px;border-radius:20px;font-size:11px}.cn-workspace .cn-category.selected{background:#e1edff;color:#145ce0}.cn-list-heading{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin:16px 0}.cn-list-heading h2{font-size:22px;margin:0 0 8px}.cn-list-heading h3{font-size:15px;margin:0}.cn-list-heading>span,.cn-list-heading p{font-size:12px;color:#617590;margin:0}.cn-app-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px}.cn-workspace .cn-app-card{text-align:left;display:flex;flex-direction:column;align-items:flex-start;position:relative;padding:20px;border:1px solid #dfe7f3;background:#fff;min-height:220px;border-radius:14px;box-shadow:0 3px 12px #274b7405;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease;color:var(--text)}.cn-workspace .cn-app-card:hover{transform:translateY(-3px);border-color:#9dbeef;box-shadow:0 10px 23px #315f9510}.cn-logo{width:44px;height:44px;display:grid;place-items:center;position:relative;flex:none;border:1px solid #e7edf5;border-radius:12px;background:#fff;overflow:hidden}.cn-logo>span{font-size:22px;font-weight:700;color:#8a9fbc}.cn-logo img{position:absolute;width:28px;height:28px;object-fit:contain;background:#fff}.cn-app-card>strong{font-size:14px;margin-top:15px}.cn-app-card>p{font-size:12px;color:#617590;line-height:1.6;margin:9px 0 20px;flex:1}.cn-card-footer{display:flex;justify-content:space-between;align-items:center;width:100%;gap:5px;font-size:10px}.cn-card-footer>span{color:#8495ae}.cn-card-footer>b{color:#1765ef;font-weight:600}.cn-card-footer .cn-connected-label{color:#27845f}.cn-more{text-align:center;margin-top:20px}.cn-bottom-note{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;font-size:12px;color:#71839f;line-height:1.6;margin-top:30px;padding-top:20px;border-top:1px solid #e0e8f4}.cn-account-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:16px}.cn-account-card{background:#fff;border:1px solid #dfe7f3;border-radius:15px;padding:22px}.cn-account-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.cn-status{font-size:10px;padding:5px 9px;border-radius:20px;background:#fff4df;color:#967126}.cn-status.active{color:#23845e;background:#eaf8f1}.cn-account-card h3{font-size:18px;margin:20px 0 6px}.cn-account-name{font-size:12px;color:#617590;overflow-wrap:anywhere}.cn-account-detail{font-size:11px;color:#8191aa;margin:18px 0}.cn-account-actions{display:flex;gap:7px;flex-wrap:wrap}.cn-empty{grid-column:1/-1;text-align:center;padding:54px 24px;border:1px dashed #cbdcf1;border-radius:16px;background:#ffffff70}.cn-empty h3{font-size:20px;margin:0 0 12px}.cn-empty p{font-size:13px;color:#71839f;line-height:1.7;max-width:420px;margin:0 auto 20px}.cn-setup-intro{margin:12px 0 26px}.cn-setup-intro h2{font-size:23px;letter-spacing:-.02em}.cn-setup-intro p,.cn-muted{font-size:12px;color:#71839f;line-height:1.7}.cn-mode-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.cn-mode-card{display:flex;flex-direction:column;align-items:flex-start;background:#fff;border:1px solid #dfe7f3;padding:24px;border-radius:15px;position:relative;cursor:pointer}.cn-mode-card:has(input:checked){border-color:#4387f5;box-shadow:0 0 0 2px #4387f514}.cn-mode-card>input{position:absolute;right:18px;top:18px;width:16px!important;min-width:16px!important;accent-color:#1765ef}.cn-mode-icon{display:grid;place-items:center;width:40px;height:40px;background:#1765ef;border-radius:12px;color:white;font-size:23px;font-weight:800;margin-bottom:20px}.cn-mode-icon.personal{background:#252932}.cn-mode-card>strong{font-size:17px}.cn-mode-card>p{font-size:13px;color:#617590;line-height:1.7;flex:1}.cn-mode-card>small{font-size:11px;color:#8191aa}.cn-key-panel{padding:22px 0;max-width:570px}.cn-key-panel p{font-size:12px;color:#71839f;line-height:1.7}.cn-key-panel a{color:#1765ef}.cn-field{display:flex;flex-direction:column;gap:8px;font-size:12px;margin:0 0 18px;color:#4d6484}.cn-field>small{font-size:11px;color:#8393a9;line-height:1.6;overflow-wrap:anywhere}.cn-workspace .cn-field input,.cn-workspace .cn-field select,.cn-workspace .cn-field textarea{background:#fff}.cn-setup-actions{display:flex;gap:10px;flex-wrap:wrap;margin:24px 0 16px}.cn-overlay{position:fixed;inset:0;background:#122c4b35;z-index:110;display:flex;justify-content:flex-end;backdrop-filter:blur(3px)}.cn-drawer{background:#f9fbff;width:min(100%,540px);height:100%;overflow-y:auto;padding:28px;box-shadow:-16px 0 70px #12325922;animation:cnDrawer .2s ease-out}.cn-drawer-heading{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:30px}.cn-drawer-heading h2{font-size:20px;letter-spacing:-.02em;margin:0;overflow-wrap:anywhere}.cn-connect-intro .cn-logo{width:64px;height:64px;border-radius:18px}.cn-connect-intro .cn-logo img{width:42px;height:42px}.cn-connect-intro h3{font-size:23px;line-height:1.3;letter-spacing:-.03em;margin:24px 0 12px}.cn-connect-intro p{font-size:13px;color:#617590;line-height:1.8}.cn-connect-steps{counter-reset:cn-step;list-style:none;margin:30px 0;padding:0}.cn-connect-steps li{counter-increment:cn-step;display:flex;align-items:center;gap:13px;font-size:13px;color:#4d6484;margin:19px 0;line-height:1.6}.cn-connect-steps li:before{content:counter(cn-step);display:grid;place-items:center;background:#e6efff;color:#1765ef;width:28px;height:28px;border-radius:50%;flex:none;font-size:12px}.cn-existing{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-top:1px solid #e1e9f4;font-size:12px}.cn-wait-orb{display:grid;place-items:center;width:64px;height:64px;border-radius:50%;background:#e8f1ff;color:#1765ef;font-size:30px}.cn-permission{display:flex;align-items:flex-start;gap:12px;padding:15px 0;border-bottom:1px solid #e1e9f4}.cn-permission input{margin-top:3px!important;accent-color:#1765ef}.cn-permission strong{font-size:13px;display:block;color:#29466e}.cn-permission small{font-size:11px;color:#71839f;display:block;line-height:1.7;margin-top:6px}.cn-actions-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:28px 0 15px}.cn-actions-heading h3{font-size:15px;margin:0}.cn-actions-heading span{font-size:11px;color:#71839f}.cn-tool-list{margin:16px 0}.cn-tool{display:flex;align-items:flex-start;gap:12px;background:#fff;border:1px solid #e1e9f4;border-radius:11px;padding:14px;margin-bottom:9px}.cn-tool input{margin-top:3px!important;accent-color:#1765ef}.cn-tool strong{display:block;font-size:12px;color:#29466e;line-height:1.6}.cn-tool small{display:block;font-size:11px;color:#71839f;line-height:1.6;margin-top:4px}.cn-tool-type{display:inline-block;font-size:9px;font-weight:500;color:#6483ad;background:#eff5ff;padding:3px 6px;border-radius:4px;margin-top:7px}.cn-sticky-actions{position:sticky;bottom:-28px;padding:18px 0;background:#f9fbfff5;display:flex;flex-wrap:wrap;gap:8px;border-top:1px solid #e1e9f4;margin-top:24px;backdrop-filter:blur(8px)}.cn-result{white-space:pre-wrap;overflow-wrap:anywhere;background:#eaf1fb;border-radius:10px;padding:15px;max-height:340px;overflow:auto;font-size:12px}.cn-argument-fields{margin-top:24px}@keyframes cnDrawer{from{transform:translateX(22px);opacity:0}to{transform:translateX(0);opacity:1}}@media(max-width:1000px){.cn-hero{flex-direction:column;padding:23px}.cn-hero h2{font-size:23px}.cn-app-grid{grid-template-columns:repeat(auto-fill,minmax(190px,1fr))}.cn-mode-grid{grid-template-columns:1fr}}@media(max-width:760px){.cn-workspace .cn-app-card{padding:16px;min-height:210px}.cn-app-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.cn-hero h2{font-size:22px}.cn-hero{padding:20px}.cn-drawer{padding:20px}.cn-sticky-actions{bottom:-20px}.cn-app-card>p{font-size:11px}.cn-card-footer{flex-wrap:wrap;gap:8px}.cn-mode-card{padding:20px}}@media(prefers-reduced-motion:reduce){.cn-drawer{animation:none}.cn-workspace .cn-app-card{transition:none}.cn-workspace .cn-app-card:hover{transform:none}}\n\n.cn-category-picker{display:flex;align-items:center;gap:12px;color:#617590;font-size:13px}.cn-category-picker select{width:auto!important;min-width:180px;max-width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:10px;background:#fff;color:#29466e}\n\n.cn-readiness{display:flex;align-items:center;flex-wrap:wrap;gap:12px;padding:16px 18px;margin-bottom:18px;border:1px solid #d5e2f3;border-radius:12px;background:#f0f6ff;color:#29456b}.cn-readiness>div{flex:1 1 240px;min-width:0}.cn-readiness strong{font-size:13px}.cn-readiness p{font-size:12px;line-height:1.6;margin:5px 0 0;overflow-wrap:anywhere}.cn-readiness .cn-button{flex:none}\n\n/* Stable, text-only action receipts below the conversation. */\n.kai-action-results { margin: 8px 0; border: 1px solid #a8bddd66; border-radius: 10px; padding: 10px 12px; max-width: 100%; font-size: 13px; overflow-wrap: anywhere; }\n.kai-action-results summary { cursor: pointer; font-weight: 600; text-align: left; }\n.kai-action-results > div { padding: 8px 0; border-top: 1px solid #a8bddd44; }\n.kai-action-results p { margin: 4px 0; font-size: 12px; line-height: 1.4; }\n.kai-action-results a { display: inline-block; margin: 4px 12px 0 0; }\n","workspace-shell.css":"/* Shared visual specification, bundled independently by each plugin. */\nhtml,body{width:100%;height:100%;margin:0}\nbody{overflow:hidden}\nbody #app,body #main{width:100%;height:100%;min-height:0;margin:0;padding:0}\nbody #main,.plugin-workspace{overflow:auto}\n.view.companion-hub{max-width:none;width:100%;min-height:100%;height:auto;margin:0;padding:0;overflow:visible}\n.companion-hub .hub-shell{display:grid;grid-template-columns:178px minmax(0,1fr);gap:0;align-items:stretch;min-height:100vh}\n.companion-hub .hub-rail{position:sticky;top:0;align-self:start;display:flex;flex-direction:column;gap:6px;min-height:100vh;max-height:100vh;overflow-y:auto;padding:24px 12px;border-right:1px solid #dce6f5;background:linear-gradient(180deg,#fbfdff,#f4f8ff);scrollbar-width:thin}\n.companion-hub .hub-rail-label{padding:0 10px 12px;color:#7184a0;font-size:10px;font-weight:650;letter-spacing:.1em;line-height:1.5;text-transform:uppercase}\n.companion-hub .hub-rail button{position:relative;display:block;width:100%;min-height:42px;margin:0;padding:11px 12px;border:1px solid transparent;border-radius:11px;background:transparent!important;color:#58708f!important;font-family:inherit;font-size:12px;font-weight:500;line-height:1.5;text-align:left;white-space:normal;overflow-wrap:anywhere;box-shadow:none;transition:background .15s,border-color .15s,box-shadow .15s,color .15s}\n.companion-hub .hub-rail button:hover{color:#155eef!important;border-color:#dce7fa;background:#fff!important;box-shadow:0 2px 7px #16376408}\n.companion-hub .hub-rail button.active{color:#155eef!important;font-weight:650;border-color:#cfdefb;background:linear-gradient(120deg,#e8f1ff,#f2f7ff)!important;box-shadow:0 2px 6px #155eef0a,inset 0 1px #ffffffc0}\n.companion-hub .hub-rail button:focus-visible{outline:2px solid #155eef;outline-offset:2px}\n.companion-hub .hub-content{min-width:0;padding:24px 26px 40px}\n.companion-hub>.hub-notice:not(:empty),.companion-hub>.an-notice:not(:empty){margin:14px 20px}\n.companion-hub .hub-shell:has(.wf-builder){grid-template-columns:minmax(0,1fr)}\n.companion-hub .hub-shell:has(.wf-builder)>.hub-rail{display:none}\n.companion-hub .hub-shell:has(.wf-builder)>.hub-content{padding:0}\n@media(max-width:960px){.companion-hub .hub-shell{grid-template-columns:158px minmax(0,1fr)}.companion-hub .hub-rail{padding:20px 10px}.companion-hub .hub-content{padding:20px}}\n@media(max-width:600px){.companion-hub .hub-shell{grid-template-columns:minmax(0,1fr);min-height:0}.companion-hub .hub-rail{position:static;flex-direction:row;flex-wrap:wrap;min-height:0;max-height:none;overflow:visible;padding:12px;border-right:0;border-bottom:1px solid #dce6f5;gap:6px}.companion-hub .hub-rail-label{width:100%;padding:0 4px 4px}.companion-hub .hub-rail button{width:auto;min-height:38px;padding:8px 11px;font-size:12px}.companion-hub .hub-content{padding:18px 14px 30px}}\n@media(prefers-reduced-motion:reduce){.companion-hub .hub-rail button{transition:none}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"1ONPggG2AxNeWWla+Krrnm+iaG3k8Eaa+Pm3RMN43uRmsa+aftyR1yjo7IuoCoSTMdjsLA4R0pPpAGayQz+tBA=="}