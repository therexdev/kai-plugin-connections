{"manifest":{"schema":1,"apiVersion":2,"id":"kai.connections","name":"KAI Connections","version":"0.1.0","description":"Connect your apps and APIs with encrypted local credentials and reviewed actions.","entry":"index.html","permissions":["connections.read","connections.manage","connections.execute"]},"files":{"app.js":"\"use strict\";\nfunction parseJson(text, kind = \"object\") { let value; try { value = JSON.parse(text); } catch { throw Error(\"Enter valid JSON before continuing.\"); } if (kind === \"array\" ? !Array.isArray(value) : !value || typeof value !== \"object\" || Array.isArray(value)) throw Error(`Expected a JSON ${kind}.`); return value; }\nfunction escapeHtml(value) { return String(value ?? \"\").replace(/[&<>\"']/g, c => ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\",\"'\":\"&#39;\"}[c])); }\nif (typeof module !== \"undefined\") module.exports = { parseJson, escapeHtml };\nif (typeof document !== \"undefined\") {\n const $=id=>document.getElementById(id),esc=escapeHtml; let state={connections:[],composio:{}},templates=[],editing=null,busy=false,apps=[],appCursor=null,access=null,accessRows=[],accessCursor=null,selected=new Map();\n function notice(text,error=false){$(\"notice\").textContent=text;$(\"notice\").className=error?\"error\":\"\";$(\"notice\").hidden=!text;}\n async function call(method,input={}){if(!window.kai?.call)throw Error(\"Open this plugin inside KAI Core 0.2.0 or later.\");return window.kai.call(method,input);}\n async function action(fn,message=\"\"){if(busy)return;busy=true;for(const b of document.querySelectorAll(\"button\"))b.disabled=true;notice(\"Waiting for Core…\");try{const result=await fn();notice(result?.cancelled?\"Cancelled. No action was taken.\":message);}catch(e){notice(e.message||\"The action failed.\",true);}finally{eraseSecrets();busy=false;for(const b of document.querySelectorAll(\"button\"))b.disabled=false;}}\n function eraseSecrets(){$(\"secret\").value=\"\";$(\"provider-key\").value=\"\";}\n function tab(name){eraseSecrets();for(const id of [\"accounts\",\"discover\",\"api\",\"run\",\"settings\"])$(id).hidden=id!==name;for(const b of document.querySelectorAll(\"[data-tab]\"))b.setAttribute(\"aria-selected\",String(b.dataset.tab===name));}\n for(const b of document.querySelectorAll(\"[data-tab]\"))b.onclick=()=>tab(b.dataset.tab);\n document.addEventListener(\"visibilitychange\",()=>{if(document.hidden)eraseSecrets();});window.addEventListener(\"pagehide\",eraseSecrets);\n function render(){\n  $(\"privacy\").textContent=state.privacyMode||\"Privacy unavailable\";$(\"provider-mode\").value=state.composio.mode||\"managed\";\n  $(\"provider-status\").textContent=state.composio.mode===\"personal\"?(state.composio.personalConfigured?\"A personal key is saved securely.\":\"Add your project key to begin.\"):(state.composio.signedIn?\"KAI account signed in. Server availability is checked when you refresh.\":\"Sign in to KAI in Core Settings to use managed connections.\");\n  $(\"account-list\").innerHTML=state.connections.length?state.connections.map(c=>`<article class=\"card\"><div class=\"spread\"><h3>${esc(c.name)}</h3><span class=\"status\">${esc(c.status)}</span></div><p class=\"muted\">${esc(c.provider===\"composio\"?c.toolkit:c.baseUrl)}</p><p class=\"mini muted\">${c.operations.length} actions · ${c.enabled?\"Enabled\":\"Disabled\"} · Agents ${c.allowAgent?\"on\":\"off\"}</p><div class=\"actions\"><button data-id=\"${esc(c.id)}\" data-action=\"run\">Run action</button><button data-id=\"${esc(c.id)}\" data-action=\"${c.provider===\"composio\"?\"access\":\"edit\"}\">${c.provider===\"composio\"?\"Permissions\":\"Edit\"}</button><button class=\"danger\" data-id=\"${esc(c.id)}\" data-action=\"remove\">${c.provider===\"composio\"?\"Disconnect\":\"Remove\"}</button></div></article>`).join(\"\"):'<div class=\"empty\">No connections yet. Sign in to an app or add an API token to get started.</div>';\n  for(const b of $(\"account-list\").querySelectorAll(\"button\"))b.onclick=()=>{const c=state.connections.find(c=>c.id===b.dataset.id);if(!c)return;if(b.dataset.action===\"run\"){tab(\"run\");$(\"run-account\").value=c.id;renderOperations();}else if(b.dataset.action===\"edit\")edit(c);else if(b.dataset.action===\"access\")void action(()=>openAccess(c));else void action(async()=>{const result=await call(c.provider===\"composio\"?\"connections.composio.disconnect\":\"connections.remove\",{id:c.id});await refresh();return result;},\"Connection removed.\");};\n  const prior=$(\"run-account\").value;$(\"run-account\").innerHTML='<option value=\"\">Select a connection</option>'+state.connections.map(c=>`<option value=\"${esc(c.id)}\">${esc(c.name)}</option>`).join(\"\");if(state.connections.some(c=>c.id===prior))$(\"run-account\").value=prior;renderOperations();\n }\n async function refresh(){state=await call(\"connections.status\");render();}\n function renderOperations(){const c=state.connections.find(c=>c.id===$(\"run-account\").value);$(\"run-operation\").innerHTML='<option value=\"\">Select an action</option>'+(c?.operations||[]).map(o=>`<option value=\"${esc(o.id)}\">${esc(o.name||o.id)}</option>`).join(\"\");renderOperation();}\n function renderOperation(){const c=state.connections.find(c=>c.id===$(\"run-account\").value),o=c?.operations.find(o=>o.id===$(\"run-operation\").value);$(\"operation-detail\").textContent=o?(o.schema?JSON.stringify(o.schema,null,2):`${o.method} ${o.path}`):\"Select a saved action.\";}\n function auth(){$(\"header-label\").hidden=$(\"auth\").value!==\"header\";$(\"secret-label\").hidden=$(\"auth\").value===\"none\";}\n function fill(t){$(\"api-name\").value=t.name;$(\"base-url\").value=t.baseUrl;$(\"auth\").value=t.auth;$(\"header-name\").value=t.headerName||\"X-API-Key\";$(\"operations\").value=JSON.stringify(t.operations.map(({id,name,method,path})=>({id,name,method,path})),null,2);$(\"headers\").value=JSON.stringify(t.headers||{},null,2);$(\"secret\").value=\"\";auth();}\n function resetApi(){editing=null;$(\"api-title\").textContent=\"Add an API connection\";$(\"api-form\").reset();fill(templates.find(t=>t.id===$(\"template\").value)||templates[0]);}\n function edit(c){tab(\"api\");editing=c.id;$(\"api-title\").textContent=\"Edit API connection\";fill(c);$(\"api-enabled\").checked=c.enabled;$(\"api-agent\").checked=c.allowAgent;$(\"api-sync\").checked=c.allowSync;}\n $(\"template\").onchange=()=>{editing=null;$(\"api-title\").textContent=\"Add an API connection\";fill(templates.find(t=>t.id===$(\"template\").value));};$(\"auth\").onchange=auth;$(\"api-reset\").onclick=resetApi;$(\"run-account\").onchange=renderOperations;$(\"run-operation\").onchange=renderOperation;\n $(\"refresh\").onclick=()=>action(async()=>{state=await call(\"connections.composio.refresh\");render();},\"Accounts refreshed.\");\n $(\"api-form\").onsubmit=e=>{e.preventDefault();void action(async()=>{const input={...(editing?{id:editing}:{}),name:$(\"api-name\").value,baseUrl:$(\"base-url\").value,auth:$(\"auth\").value,headerName:$(\"header-name\").value,secret:$(\"secret\").value,headers:parseJson($(\"headers\").value),operations:parseJson($(\"operations\").value,\"array\"),enabled:$(\"api-enabled\").checked,allowAgent:$(\"api-agent\").checked,allowSync:$(\"api-sync\").checked};eraseSecrets();const result=await call(\"connections.save\",input);input.secret=\"\";if(!result.cancelled){await refresh();resetApi();tab(\"accounts\");}return result;},\"API connection saved.\");};\n $(\"provider-form\").onsubmit=e=>{e.preventDefault();void action(async()=>{const input={mode:$(\"provider-mode\").value,key:$(\"provider-key\").value,clearKey:$(\"clear-key\").checked};eraseSecrets();const result=await call(\"connections.composio.settings\",input);input.key=\"\";$(\"clear-key\").checked=false;await refresh();return result;},\"Provider settings saved.\");};\n async function searchApps(more=false){if(state.composio.mode===\"managed\"&&state.composio.managedAvailable===null){state=await call(\"connections.composio.refresh\");render();}const page=await call(\"connections.composio.catalog\",{search:$(\"search\").value,...(more&&appCursor?{cursor:appCursor}:{})});apps=more?[...apps,...page.items]:page.items;appCursor=page.nextCursor||null;$(\"more-apps\").hidden=!appCursor;$(\"apps\").innerHTML=apps.length?apps.map((a,i)=>`<article class=\"card\"><h3>${esc(a.name||a.id)}</h3><p class=\"muted\">${esc(a.description)}</p><button data-app=\"${i}\">Connect app</button></article>`).join(\"\"):'<div class=\"empty\">No apps match this search.</div>';for(const b of $(\"apps\").querySelectorAll(\"button\"))b.onclick=()=>action(async()=>{const a=apps[Number(b.dataset.app)];return call(\"connections.composio.connect\",{toolkit:a.id||a.slug});},\"Complete sign-in in your browser, then refresh your accounts.\");}\n $(\"search-form\").onsubmit=e=>{e.preventDefault();void action(()=>searchApps());};$(\"more-apps\").onclick=()=>action(()=>searchApps(true));\n async function openAccess(c){access=c;selected=new Map(c.operations.map(o=>[o.id,{id:o.id,version:o.version}]));$(\"access-name\").value=c.name;$(\"allow-write\").checked=c.allowWrite;$(\"allow-agent\").checked=c.allowAgent;$(\"allow-sync\").checked=c.allowSync;$(\"access-search\").value=\"\";$(\"access-title\").textContent=`Permissions · ${c.name}`;$(\"access-form\").hidden=false;await loadAccess();$(\"access-form\").scrollIntoView({behavior:\"smooth\"});}\n async function loadAccess(more=false){if(!access)return;const page=await call(\"connections.composio.tools\",{toolkit:access.toolkit,search:$(\"access-search\").value,...(more&&accessCursor?{cursor:accessCursor}:{})});accessRows=more?[...accessRows,...page.items]:page.items;accessCursor=page.nextCursor||null;$(\"access-more\").hidden=!accessCursor;renderAccess();}\n function renderAccess(){const shown=new Map([...access.operations,...accessRows].map(t=>[t.id,t]));$(\"access-tools\").innerHTML=[...shown.values()].map(t=>`<label class=\"check\"><input type=\"checkbox\" data-tool=\"${esc(t.id)}\" ${selected.has(t.id)?\"checked\":\"\"}><span>${esc(t.name||t.id)}<br><small>${esc(t.description||t.id)} · ${t.readOnly?\"Read\":\"May change data\"}</small></span></label>`).join(\"\")||'<p class=\"muted\">No actions found.</p>';for(const input of $(\"access-tools\").querySelectorAll(\"input\"))input.onchange=()=>{const t=shown.get(input.dataset.tool);input.checked?selected.set(t.id,{id:t.id,version:t.version}):selected.delete(t.id);};}\n $(\"access-find\").onclick=()=>action(()=>loadAccess());$(\"access-more\").onclick=()=>action(()=>loadAccess(true));$(\"access-close\").onclick=()=>{$(\"access-form\").hidden=true;access=null;};\n $(\"access-form\").onsubmit=e=>{e.preventDefault();void action(async()=>{if(!access)throw Error(\"Choose an account first.\");const result=await call(\"connections.composio.permissions\",{id:access.id,name:$(\"access-name\").value,tools:[...selected.values()],allowWrite:$(\"allow-write\").checked,allowAgent:$(\"allow-agent\").checked,allowSync:$(\"allow-sync\").checked});if(!result.cancelled){state=result;render();$(\"access-form\").hidden=true;access=null;}return result;},\"Account permissions saved.\");};\n $(\"run-form\").onsubmit=e=>{e.preventDefault();void action(async()=>{if(!$(\"run-account\").value||!$(\"run-operation\").value)throw Error(\"Select a connection and an action.\");const result=await call(\"connections.execute\",{id:$(\"run-account\").value,operationId:$(\"run-operation\").value,variables:parseJson($(\"variables\").value),body:parseJson($(\"body\").value)});if(!result.cancelled)$(\"result\").textContent=typeof result.result===\"string\"?result.result:JSON.stringify(result.result,null,2);await refresh();return result;},\"Action completed.\");};\n void action(async()=>{templates=await call(\"connections.templates\");$(\"template\").innerHTML=templates.map(t=>`<option value=\"${esc(t.id)}\">${esc(t.name)}</option>`).join(\"\");resetApi();await refresh();});\n}\n","index.html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'\"><title>KAI Connections</title><link rel=\"stylesheet\" href=\"style.css\"></head><body><main>\n<header><div><div class=\"eyebrow\">KAI / Connections</div><h1>Your apps. Your control.</h1><p class=\"lead\">Connect accounts and APIs, choose their available actions, and keep saved credentials encrypted in Core.</p></div><span class=\"pill\" id=\"privacy\">Connecting to Core</span></header><div id=\"notice\" role=\"status\" aria-live=\"polite\" hidden></div>\n<nav aria-label=\"Connection sections\"><button data-tab=\"accounts\" aria-selected=\"true\">Your connections</button><button data-tab=\"discover\" aria-selected=\"false\">Connect an app</button><button data-tab=\"api\" aria-selected=\"false\">Add an API</button><button data-tab=\"run\" aria-selected=\"false\">Run an action</button><button data-tab=\"settings\" aria-selected=\"false\">Provider settings</button></nav>\n<section id=\"accounts\"><div class=\"panel spread\"><div><h2>A home for your connected accounts</h2><p class=\"muted\">Your existing connections stay in the same local store. Agent and background access are choices you control.</p></div><button id=\"refresh\">Refresh accounts</button></div><div id=\"account-list\" class=\"cards\"></div><form id=\"access-form\" class=\"panel stack\" hidden><h2 id=\"access-title\">Account access</h2><label>Account label<input id=\"access-name\" maxlength=\"80\"></label><p class=\"muted\">Choose the actions this account makes available. Write actions also require the permission below.</p><div class=\"actions\"><input id=\"access-search\" placeholder=\"Search available actions\" aria-label=\"Search available actions\"><button id=\"access-find\" type=\"button\">Search</button></div><div id=\"access-tools\" class=\"tool-list\"></div><button id=\"access-more\" type=\"button\" hidden>More actions</button><label class=\"check\"><input id=\"allow-write\" type=\"checkbox\">Allow selected actions to change data</label><label class=\"check\"><input id=\"allow-agent\" type=\"checkbox\">Allow my personal agents to use selected actions</label><label class=\"check\"><input id=\"allow-sync\" type=\"checkbox\">Allow background sources to read selected data</label><div class=\"actions\"><button class=\"primary\" type=\"submit\">Review permissions</button><button id=\"access-close\" type=\"button\">Close</button></div></form></section>\n<section id=\"discover\" hidden><form id=\"search-form\" class=\"panel\"><h2>Find an app</h2><p class=\"muted\">Composio handles account authorization in your browser. Configure your provider first, then search.</p><div class=\"actions\"><input id=\"search\" placeholder=\"Search apps, for example GitHub\" aria-label=\"Search apps\"><button class=\"primary\" type=\"submit\">Search apps</button></div></form><div id=\"apps\" class=\"cards\"></div><button id=\"more-apps\" hidden>More apps</button><p class=\"note\">After completing browser sign-in, use Refresh accounts to load your connection.</p></section>\n<section id=\"api\" hidden><div class=\"grid\"><form id=\"api-form\" class=\"panel stack\"><h2 id=\"api-title\">Add an API connection</h2><label>Template<select id=\"template\"></select></label><label>Name<input id=\"api-name\" required maxlength=\"80\"></label><label>API base URL<input id=\"base-url\" type=\"url\" required></label><label>Authentication<select id=\"auth\"><option value=\"bearer\">Bearer token</option><option value=\"header\">API key header</option><option value=\"none\">None</option></select></label><label id=\"header-label\" hidden>Secret header name<input id=\"header-name\" value=\"X-API-Key\"></label><label id=\"secret-label\">API token<input id=\"secret\" type=\"password\" autocomplete=\"new-password\" maxlength=\"4096\" placeholder=\"Enter a token; saved tokens are never displayed\"></label><label class=\"check\"><input id=\"api-enabled\" type=\"checkbox\" checked>Enabled</label><label class=\"check\"><input id=\"api-agent\" type=\"checkbox\">Allow personal agent access</label><label class=\"check\"><input id=\"api-sync\" type=\"checkbox\">Allow background source reads</label><div class=\"actions\"><button class=\"primary\" type=\"submit\">Review and save</button><button id=\"api-reset\" type=\"button\">New connection</button></div></form><div class=\"panel stack\"><h2>Available actions</h2><p class=\"muted\">Each action has a unique lowercase ID, name, HTTP method, and relative path. Use {name} for path variables.</p><label>Operations (JSON array)<textarea id=\"operations\" rows=\"13\" spellcheck=\"false\"></textarea></label><label>Public API-version headers (JSON object)<textarea id=\"headers\" spellcheck=\"false\">{}</textarea></label><p class=\"note\">Tokens pass to Core once for encrypted storage and are cleared from this form. Each manual action has a separate native review.</p></div></div></section>\n<section id=\"run\" hidden><div class=\"grid\"><form id=\"run-form\" class=\"panel stack\"><h2>Run a saved action</h2><label>Connection<select id=\"run-account\"></select></label><label>Action<select id=\"run-operation\"></select></label><pre id=\"operation-detail\">Select a connection.</pre><label>Path variables / app arguments (JSON object)<textarea id=\"variables\" spellcheck=\"false\">{}</textarea></label><label>API request body (JSON, for write operations)<textarea id=\"body\" spellcheck=\"false\">{}</textarea></label><button type=\"submit\" class=\"primary\">Review and run</button></form><div class=\"panel\"><h2>Result</h2><p class=\"muted\">Saved credentials remain in Core. This view displays the selected action's response.</p><pre id=\"result\">No action has run yet.</pre></div></div></section>\n<section id=\"settings\" hidden><div class=\"grid\"><form id=\"provider-form\" class=\"panel stack\"><h2>Connection provider</h2><p id=\"provider-status\" class=\"muted\"></p><label>Mode<select id=\"provider-mode\"><option value=\"managed\">KAI-managed connections</option><option value=\"personal\">My Composio project</option></select></label><label>Composio project API key<input id=\"provider-key\" type=\"password\" autocomplete=\"new-password\" maxlength=\"4096\" placeholder=\"Leave blank to keep the saved key\"></label><label class=\"check\"><input id=\"clear-key\" type=\"checkbox\">Remove the saved personal key</label><button class=\"primary\" type=\"submit\">Review provider settings</button></form><div class=\"panel\"><h2>Credentials stay with you</h2><p class=\"muted\">Core encrypts credentials using your operating system's secure storage. This plugin receives account metadata and selected action responses.</p><p class=\"note\">KAI-managed connections require account sign-in and a server configured for Composio. Your own project works with a Composio API key. Local-Only blocks account API requests.</p><p class=\"muted\">Connecting an account does not grant it to rented agents or publish it to the Agent Network.</p></div></div></section><footer>KAI Connections 0.1.0 · Requires KAI Core 0.2.0 · Existing account data remains in place.</footer></main><script src=\"app.js\"></script></body></html>","style.css":":root{color-scheme:dark;--bg:#10151c;--panel:#19222d;--line:#2c3948;--text:#e8edf3;--muted:#9fafc0;--accent:#82dec4;--danger:#ffb3ac;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-size:14px;line-height:1.55}main{max-width:1220px;margin:auto;padding:38px 38px 70px}header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:30px}.eyebrow{text-transform:uppercase;color:var(--accent);font-size:11px;letter-spacing:.17em;font-weight:700}h1{font-size:32px;letter-spacing:-.035em;line-height:1.2;margin:8px 0 12px}h2{font-size:19px;margin:0 0 8px}h3{font-size:16px;margin:0 0 5px}p{margin:0 0 14px}.muted,small{color:var(--muted)}.lead{max-width:640px;color:var(--muted)}.pill{border:1px solid var(--line);padding:6px 11px;border-radius:30px;font-size:12px;white-space:nowrap;color:var(--accent)}nav{display:flex;gap:7px;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:24px;overflow:auto}button{font:inherit;font-weight:600;background:#253343;color:var(--text);border:1px solid #394c60;border-radius:9px;padding:9px 14px;cursor:pointer}button:hover{background:#35495e}button.primary{background:var(--accent);color:#102620;border-color:var(--accent)}button.primary:hover{background:#a3efd9}button.danger{color:var(--danger)}button:disabled{opacity:.5;cursor:wait}nav button{border-color:transparent;background:transparent;color:var(--muted)}nav button[aria-selected=\"true\"]{background:#223930;color:var(--accent)}:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:24px;margin-bottom:20px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(245px,1fr));gap:14px}.card{border:1px solid var(--line);border-radius:12px;padding:20px;background:#17202a;min-width:0;overflow-wrap:anywhere}.card .actions{margin-top:18px}.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.spread{display:flex;justify-content:space-between;gap:12px;align-items:start}.stack{display:grid;gap:15px}label{display:grid;gap:6px;color:var(--muted);font-size:13px}label.check{display:flex;align-items:start;gap:9px}input,select,textarea{font:inherit;color:var(--text);border:1px solid #3a4b60;background:#111923;border-radius:8px;padding:10px;width:100%;min-width:0}input[type=\"checkbox\"]{width:17px;height:17px;accent-color:var(--accent);flex:none;margin-top:2px}textarea{resize:vertical;min-height:100px;font-family:ui-monospace,monospace;font-size:12px}pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:460px;overflow:auto;background:#111923;border:1px solid var(--line);border-radius:9px;padding:16px;font-size:12px;margin:12px 0 0}#notice{padding:12px 16px;margin:0 0 20px;border:1px solid #3d796a;border-radius:10px;background:#17312b;overflow-wrap:anywhere}#notice.error{border-color:#8c4c46;background:#39221f;color:#ffd1cc}.empty{color:var(--muted);border:1px dashed var(--line);padding:30px;border-radius:12px;text-align:center}.note{border-left:3px solid var(--accent);padding:8px 14px;color:var(--muted);font-size:13px;margin:14px 0}.mini{font-size:12px;margin-top:5px}.tool-list{display:grid;gap:10px;margin:15px 0;max-height:360px;overflow:auto}.tool-list label{border:1px solid var(--line);border-radius:8px;padding:11px}.status{font-size:12px;color:var(--accent)}.count{font-size:28px;font-weight:600;color:var(--accent)}[hidden]{display:none!important}details summary{cursor:pointer;color:var(--muted);margin:14px 0}footer{color:var(--muted);font-size:12px;margin-top:30px}@media(max-width:750px){main{padding:24px 18px}.grid{grid-template-columns:1fr}header{align-items:start}h1{font-size:27px}.panel{padding:18px}}"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"ecuXqie0+W3Iwnp8iscv+Y07abajDIjZ2qii4eD0NXLaF70EwUOt5QkU+Ke84cUmgi9wpfQPN1TJVNHNS/6fDg=="}